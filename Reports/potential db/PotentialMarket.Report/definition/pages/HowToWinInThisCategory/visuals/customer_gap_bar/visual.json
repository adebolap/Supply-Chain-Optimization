{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "customer_gap_bar",
  "position": {
    "x": 16,
    "y": 182,
    "z": 0,
    "height": 170,
    "width": 1248,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Cust"
                    }
                  },
                  "Property": "Customer Name"
                }
              },
              "queryRef": "Dim_Cust.Customer Name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_market_potential"
                    }
                  },
                  "Property": "Pot Realized Qty"
                }
              },
              "queryRef": "Sum(fact_market_potential.Pot Realized Qty)",
              "active": true
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_market_potential"
                    }
                  },
                  "Property": "Pot Gap Units"
                }
              },
              "queryRef": "Sum(fact_market_potential.Pot Gap Units)",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Top customer gaps in category'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  }
}