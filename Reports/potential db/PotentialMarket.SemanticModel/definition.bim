        "partitions": [
          {
            "name": "Shp_Dim_SalesRep_Hierarchy-50050c37-84cc-4b93-9841-cb9718228c91",
            "mode": "import",
            "queryGroup": "6. Security",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = SharePoint.Files(Sharepoint, [ApiVersion = 15]),",
                "    #\"00  Dim_SalesRep_Hierarchy xlsx_https://terumoemea sharepoint com/teams/TISSalesGPReport/Shared Documents/\" = Source{[Name=\"00. Dim_SalesRep_Hierarchy.xlsx\",#\"Folder Path\"=Folder]}[Content],",
                "    #\"Imported Excel\" = Excel.Workbook(#\"00  Dim_SalesRep_Hierarchy xlsx_https://terumoemea sharepoint com/teams/TISSalesGPReport/Shared Documents/\"),",
                "    SalesRep_Hierarchy_Sheet = #\"Imported Excel\"{[Item=\"SalesRep_Hierarchy\",Kind=\"Sheet\"]}[Data],",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(SalesRep_Hierarchy_Sheet, [PromoteAllScalars=true]),",
                "    // Prefix \"00\" when length is 6 or 7 (also for any <=7 if you want)",
                "    #\"Added RepCode (normalized)\" =",
                "        Table.AddColumn(",
                "            #\"Promoted Headers\",",
                "            \"Sales Representative Code\",",
                "            each",
                "                let emp = try Text.Trim([Employee Number Sales Reps]) otherwise null",
                "                in",
                "                    if emp = null or emp = \"\" then \"00\"",
                "                    else if Text.Length(emp) <= 7 then \"00\" & emp",
                "                    else emp,",
                "            type text",
                "        ),",
                "    #\"Cleaned Text\" = Table.TransformColumns(#\"Added RepCode (normalized)\",{{\"Employee Number Sales Reps\", Text.Clean, type text}}),",
                "    #\"Trimmed Text\" = Table.TransformColumns(#\"Cleaned Text\",{{\"Employee Number Sales Reps\", Text.Trim, type text}}),",
                "",
                "    // Build Index using the normalized code",
                "    #\"Added Custom = Index RepsPdt.AreaCode\" =",
                "        Table.AddColumn(",
                "            #\"Trimmed Text\",",
                "            \"Index_Reps_ProductAreaCode\",",
                "            each Text.From([Sales Representative Code]) & \"-\" & Text.From(try [Product Area Code] otherwise \"\") & \"-\" & Text.From(try [Sales Organisation] otherwise \"\"),",
                "            type text",
                "        ),",
                "",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Added Custom = Index RepsPdt.AreaCode\", each ([Employee Name Sales Reps] <> \"Angio Duplicates Offset\" and [Employee Name Sales Reps] <> \"Not Assigned TPT VCD Cardio\" and [Employee Name Sales Reps] <> \"Not Assigned VCD Cardio\" and [Employee Name Sales Reps] <> \"VCD Cardio Duplicates Offset\" and [Employee Name Sales Reps] <> \"VCD IO Duplicates Offset\")),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Filtered Rows\",{{\"Index_Reps_ProductAreaCode\", type text}})",
                "in",
                "    #\"Changed Type1\""
              ]
            }
          }
        ],
