              "  AND(min('Button €/LC'[ID])=2,min('Button FiscalYTD'[ID])=2),CALCULATE(SUM('DATA'[Deemed Cost Actual (LC)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscLY2]),Dim_Cal[IsFiscLY2]=1)),",
