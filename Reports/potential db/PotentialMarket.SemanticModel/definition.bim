            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", type text}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"Column1\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "FY Figures CY",
            "description": "[AUTO-REWRITTEN] High-performance selector measure.",
            "expression": [
              "VAR _index = SELECTEDVALUE('Button Figures'[Index], 1)",
              "RETURN",
              "SWITCH(",
              "    _index,",
              "    1, [FY Sales CY],",
              "    2, [FY Units CY],",
              "    3, [FY ASP CY],",
              "    4, [FY GP CY]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "1.C FY Period Comparison (select figures)",
