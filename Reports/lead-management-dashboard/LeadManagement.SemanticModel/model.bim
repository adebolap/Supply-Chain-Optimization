            "lineageTag": "80ab450d-2cf4-4a83-a9b0-4432215cac5b"
          },
          {
            "name": "Revenue by Stage",
            "displayFolder": "8. Breakdowns",
            "expression": "CALCULATE(SUM('Opportunity'[Amount]),ALLEXCEPT('Opportunity','Opportunity'[StageName]))",
            "formatString": "€#,0",
