            "expression": [
              "VAR _index = SELECTEDVALUE('Button Figures'[Index], 1)",
              "RETURN",
              "SWITCH(",
              "    _index,",
              "    1, [FY Sales Plan],",
              "    2, [FY Units Plan],",
              "    3, [FY ASP Plan],",
              "    4, [FY GP Plan]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "1.C FY Period Comparison (select figures)",
            "lineageTag": "3db62378-a51d-4555-a683-8affac119e1a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "FY Figures vsPlan%",
            "description": "Calculates the growth between current FY KPI figures and current FY Plan KPI figures (variance in %)",
            "expression": "DIVIDE([FY Figures CY],[FY Figures Plan],Blank())",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "1.C FY Period Comparison (select figures)",
            "lineageTag": "f4dbd502-5b5a-465c-af82-2a250612d0d2"
