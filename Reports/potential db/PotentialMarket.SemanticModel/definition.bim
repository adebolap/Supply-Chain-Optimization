        "partitions": [
          {
            "name": "Data_SA-6fc706dc-a820-4a1f-9775-f063225cff85",
            "mode": "import",
            "queryGroup": "3. Sales Assignement Dimension",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // ====================================================================",
                "    // STEP 1: COMBINE SOURCE TABLES",
                "    // ====================================================================",
                "    Source1 = Table.Combine({",
                "        #\"Sales Assignment SR1\",",
                "        #\"Sales Assignment SR3\",",
                "        #\"Sales Assignment SR2\",",
                "        #\"Shp_Data Sales Assignment Budget TD\"",
                "    }),",
                "    ",
                "    // ====================================================================",
                "    // STEP 2: AGGRESSIVE COLUMN CLEANUP",
                "    // Remove ALL columns that could conflict with Dim_Product expansion",
                "    // This prevents the \"Business Unit already exists\" error",
                "    // ====================================================================",
                "    ",
                "    ConflictingColumns = {",
                "        \"Business Unit\",           // Main culprit causing current error",
                "        \"Business Unit Text\",      // In Dim_Product - will be expanded",
                "        \"Product Area Code\",       // In Dim_Product - will be expanded",
                "        \"Product Area\",            // In Dim_Product",
                "        \"Product Area Text\",       // In Dim_Product",
                "        \"Product Group\",           // Possibly in dataflow",
                "        \"Product Group 1\",         // In Dim_Product",
                "        \"Product Group 2\",         // In Dim_Product",
                "        \"Product Group 3\",         // In Dim_Product",
                "        \"Product Group Text\",      // In Dim_Product",
                "        \"Product Subgroup Text\",   // In Dim_Product",
                "        \"Business Line Text\",      // In Dim_Product",
                "        \"Material Description\",    // In Dim_Product",
                "        \"Product Hierarchy Code\",  // In Dim_Product",
                "        \"Profit Center\",           // In Dim_Product",
                "        \"Profit Center 2\",         // In Dim_Product",
                "        \"Profit Center 3\",         // In Dim_Product",
                "        \"Portfolio Category\",      // In Dim_Product",
                "        \"Portfolio Category 2\"     // In Dim_Product",
                "    },",
                "    ",
                "    CleanedSource1 = Table.RemoveColumns(",
                "        Source1,",
                "        ConflictingColumns,",
                "        MissingField.Ignore",
                "    ),",
                "    ",
                "    // Also clean the budget table before appending",
                "    CleanedBudget = Table.RemoveColumns(",
                "        #\"Shp_Data Sales Assignment Budget\",",
                "        ConflictingColumns,",
                "        MissingField.Ignore",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 3: APPEND CLEANED TABLES",
                "    // ====================================================================",
                "    Appended = Table.Combine({CleanedSource1, CleanedBudget}),",
                "    ",
                "    // ====================================================================",
                "    // STEP 4: MERGE WITH DIM_PRODUCT",
                "    // ====================================================================",
                "    Dim_Product_Buffered = Table.Buffer(Dim_Product),",
                "    ",
                "    MergedQueries = Table.NestedJoin(",
                "        Appended,",
                "        {\"Material\"},",
                "        Dim_Product_Buffered,",
                "        {\"Material\"},",
                "        \"Dim_Product\",",
                "        JoinKind.LeftOuter",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 5: EXPAND WITH PREFIX STRATEGY",
                "    // Use \"DP.\" prefix to avoid any potential name collision",
                "    // ====================================================================",
                "    ExpandedProduct = Table.ExpandTableColumn(",
                "        MergedQueries,",
                "        \"Dim_Product\",",
                "        {\"Business Unit Text\", \"Product Area Code\"},",
                "        {\"DP.Business Unit Text\", \"DP.Product Area Code\"}",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 6: RENAME TO FINAL NAMES",
                "    // Now safe because original conflicting columns were removed in Step 2",
                "    // ====================================================================",
                "    RenamedColumns = Table.RenameColumns(",
                "        ExpandedProduct,",
                "        {",
                "            {\"DP.Business Unit Text\", \"Business Unit Text\"},",
                "            {\"DP.Product Area Code\", \"Product Area Code\"}",
                "        },",
                "        MissingField.Ignore",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 7: FILTER BUSINESS UNIT = TIS",
                "    // ====================================================================",
                "    FilterTIS = Table.SelectRows(RenamedColumns, each [Business Unit Text] = \"TIS\"),",
                "    ",
                "    // ====================================================================",
                "    // STEP 8: ADD INDEX WITH NULL SAFETY",
                "    // ====================================================================",
                "    WithIndex = Table.AddColumn(",
                "        FilterTIS,",
                "        \"Index_Reps_ProductAreaCode\",",
                "        each",
                "            Text.From(if [Sales Representative Code] = null then \"\" else [Sales Representative Code]) & \"-\" &",
                "            Text.From(if [Product Area Code] = null then \"\" else [Product Area Code]) & \"-\" &",
                "            Text.From(if [Sales Organization] = null then \"\" else [Sales Organization]),",
                "        type text",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 9: KEEP ONLY REQUIRED COLUMNS (matches original query)",
                "    // ====================================================================",
                "    RemovedOtherColumns = Table.SelectColumns(",
                "        WithIndex,",
                "        {",
                "            \"Key Account Manager Mail\",",
                "            \"SalesAssignmentID\",",
                "            \"Key Account Manager\",",
                "            \"Key Account Manager Name\",",
                "            \"Sales Representative Mail\",",
                "            \"Sales Representative Code\",",
                "            \"Sales Representative Name\",",
                "            \"Sales Reps Level\",",
                "            \"Index_Reps_ProductAreaCode\"",
                "        },",
                "        MissingField.UseNull",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 10: EMAIL NORMALIZATION - DUPLICATE COLUMN",
                "    // ====================================================================",
                "    DuplicatedColumn = Table.DuplicateColumn(",
                "        RemovedOtherColumns,",
                "        \"Sales Representative Mail\",",
                "        \"Sales Representative Mail - Copy\"",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 11: EMAIL NORMALIZATION - UPPERCASE",
                "    // ====================================================================",
                "    UppercasedText = Table.TransformColumns(",
                "        DuplicatedColumn,",
                "        {{\"Sales Representative Mail - Copy\", Text.Upper, type text}}",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 12: MERGE WITH USERPRINCIPALNAME",
                "    // ====================================================================",
                "    MergedQueries1 = Table.NestedJoin(",
                "        UppercasedText,",
                "        {\"Sales Representative Mail - Copy\"},",
                "        UserPrincipalName,",
                "        {\"mail - Copy\"},",
                "        \"UserPrincipalName\",",
                "        JoinKind.LeftOuter",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 13: EXPAND USERPRINCIPALNAME",
                "    // ====================================================================",
                "    ExpandedUserPrincipalName = Table.ExpandTableColumn(",
                "        MergedQueries1,",
                "        \"UserPrincipalName\",",
                "        {\"Corrected_mail\"},",
                "        {\"Corrected_mail\"}",
                "    ),",
                "    ",
                "    // ====================================================================",
                "    // STEP 14: ADD FINAL MAIL COLUMN",
                "    // ====================================================================",
                "    AddedCustom = Table.AddColumn(",
                "        ExpandedUserPrincipalName,",
                "        \"Sales Representative Mail Final\",",
                "        each if [Corrected_mail] <> null then [Corrected_mail] else [Sales Representative Mail],",
                "        type text",
                "    )",
                "in",
                "    AddedCustom"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Branch & KAM Name",
            "expression": [
              "",
              "VAR BranchName =",
              "    SELECTEDVALUE('Shp_Dim_Country_Hierarchy'[Branch Name], \"Unknown Branch\")",
              "VAR KAMName =",
              "    SELECTEDVALUE('DATA_SA'[Key Account Manager Name], \"Unknown KAM\")",
              "RETURN",
              "BranchName & \" - \" & KAMName"
            ],
            "lineageTag": "dbed6cb4-535b-43c3-bb2a-5530c8183c41"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
