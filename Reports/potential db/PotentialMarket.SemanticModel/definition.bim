          },
          {
            "name": "CalY Sales CY",
            "description": "Calculates the sum of current CY Net sales based on period view and currency selected",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    AND(min('Button €/LC'[ID])=1,min('Button CalYTD'[ID])=2),CALCULATE(SUM('DATA'[Net Sales Actual (EUR)]),FILTER(VALUES('Dim_Cal'[IsCalCY]),Dim_Cal[IsCalCY]=1)),",
              "    AND(min('Button €/LC'[ID])=2,min('Button CalYTD'[ID])=2),CALCULATE(SUM('DATA'[Net Sales Actual]),FILTER(VALUES('Dim_Cal'[IsCalCY]),Dim_Cal[IsCalCY]=1)),",
              "   AND(min('Button €/LC'[ID])=1,min('Button CalYTD'[ID])=1),CALCULATE(SUM('DATA'[Net Sales Actual (EUR)]),FILTER(VALUES('Dim_Cal'[IsCalYTD]),Dim_Cal[IsCalYTD]=TRUE),FILTER(VALUES('Dim_Cal'[IsCalCY]),Dim_Cal[IsCalCY]=1)),",
              "   AND(min('Button €/LC'[ID])=2,min('Button CalYTD'[ID])=1),CALCULATE(SUM('DATA'[Net Sales Actual]),FILTER(VALUES('Dim_Cal'[IsCalYTD]),Dim_Cal[IsCalYTD]=TRUE),FILTER(VALUES('Dim_Cal'[IsCalCY]),Dim_Cal[IsCalCY]=1)))"
            ],
            "formatString": "#,0",
            "displayFolder": "2.A Calendar Year Measure Comparison (select period)",
            "lineageTag": "999f5374-331a-4c9d-8822-dabf1d53d66f"
          },
