        "partitions": [
          {
            "name": "fact_market_potential",
            "mode": "import",
            "queryGroup": "7. Potential",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:/Users/adebo/reports/potential db/data/fact_market_potential.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"region_group\", type text}, {\"country_code\", type text}, {\"country_name\", type text}, {\"country_iso2\", type text}, {\"country_text\", type text}, {\"customer_id_\", type text}, {\"customer_id\", type text}, {\"customer_name\", type text}, {\"customer_segment\", type text}, {\"Final Destination\", type text}, {\"Final Destination Text\", type text}, {\"year\", type text}, {\"procedure_group\", type text}, {\"terumo_category\", type text}, {\"terumo_category_key\", type text}, {\"qty_units_per_procedure\", type text}, {\"mapping_row_count\", type text}, {\"procedures\", type text}, {\"usage_rate_final\", type text}, {\"mapping_cardinality\", type text}, {\"allocation_weight\", type text}, {\"customer_market_key\", type text}, {\"final_destination_key\", type text}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Pot Total Potential Units",
            "description": "Modeled addressable units.",
            "expression": [
              "",
              "SUMX (",
              "    fact_market_potential,",
              "    VAR Procedures =",
              "        COALESCE ( VALUE ( fact_market_potential[procedures] ), 0 )",
              "    VAR UnitsPerProcedure =",
              "        COALESCE ( VALUE ( fact_market_potential[qty_units_per_procedure] ), 0 )",
              "    VAR UsageRate =",
              "        COALESCE ( VALUE ( fact_market_potential[usage_rate_final] ), 1 )",
              "    VAR AllocationWeight =",
              "        COALESCE ( VALUE ( fact_market_potential[allocation_weight] ), 1 )",
              "    RETURN",
              "        Procedures * UnitsPerProcedure * UsageRate * AllocationWeight",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\01 Core",
            "lineageTag": "b9f316bb-1abc-4c9c-95f7-b012c739c96c"
          },
          {
            "name": "Pot Total Potential Units (2024)",
            "description": "Denominator fixed to procedure year 2024.",
            "expression": [
              "",
              "CALCULATE (",
              "    [Pot Total Potential Units],",
              "    KEEPFILTERS ( fact_market_potential[year] = \"2024\" )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS Pilot\\01 Core",
            "lineageTag": "62276c40-b59f-4dc7-9344-99c11b42537d"
          },
          {
            "name": "Pot Total Procedures (dedup)",
            "description": "Deduped procedure volumes.",
            "expression": "SUMX(SUMMARIZE(fact_market_procedures_ready, fact_market_procedures_ready[customer_id], fact_market_procedures_ready[country_iso2], fact_market_procedures_ready[year], fact_market_procedures_ready[procedure_group]), CALCULATE(MAX(fact_market_procedures_ready[procedures])))",
            "formatString": "#,0",
            "displayFolder": "MS v2\\01 Core",
            "lineageTag": "efcc0b03-989b-45f5-a5af-8cbd9b87e2c2"
          },
          {
            "name": "Pot Realized Qty",
            "description": "Import Sales_By_Category.",
            "expression": [
              "VAR CurrentYear = [_Current Sales Year]",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( Sales_Category[Qty Sold] ),",
              "        KEEPFILTERS ( Sales_Category[Year] = CurrentYear )",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\01 Core",
            "lineageTag": "f9376452-bcc5-401e-bcde-8f34573e9a5d"
          },
          {
            "name": "Pot Realized Sales EUR (DNA total)",
            "description": "Total DNA sales — not by Terumo category.",
            "expression": [
              "CALCULATE (",
              "    SUM ( 'DATA'[Net Sales Actual (EUR)] ),",
              "    'DATA'[Value Type for Reporting Text] = \"Actual\"",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "MS v2\\01 Core",
            "lineageTag": "caf8c47f-5d79-4c66-8fa9-462fb4f6d5cf"
          },
          {
            "name": "Pot Gap Units",
            "description": "Import Sales_By_Category.",
            "expression": [
              "",
              "MAX ( 0, [MS Targetable Units] - [Pot Realized Qty] )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\04 Opportunity",
            "lineageTag": "06cb4aad-b293-4eaa-bd7e-69fef71b402a"
          },
          {
            "name": "Pot Realization %",
            "description": "Import Sales_By_Category.",
            "expression": [
              "",
              "[MS Estimated Share %]",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "MS v2\\01 Core",
            "lineageTag": "0e5abbfd-1f92-4b3e-8a5a-6062a73c06b7"
          },
          {
            "name": "Pot Realized Sales EUR",
            "expression": [
              "VAR CurrentYear = [_Current Sales Year]",
              "RETURN",
              "    CALCULATE (",
              "        SUM ( Sales_Category[Sales EUR] ),",
              "        KEEPFILTERS ( Sales_Category[Year] = CurrentYear )",
              "    )"
            ],
            "formatString": "€#,##0",
            "displayFolder": "MS v2\\01 Core",
            "lineageTag": "d1fb3950-4435-4396-9d74-80c23d6c9139"
          },
          {
            "name": "Pot Avg Price EUR",
            "expression": [
              "",
              "VAR AccountASP =",
              "    DIVIDE ( [Pot Realized Sales EUR], [Pot Realized Qty] )",
              "RETURN",
              "    COALESCE ( AccountASP, [MS Avg Price by Category], 0 )",
              ""
            ],
            "formatString": "€#,##0.00;€-#,##0.00;€0.00",
            "displayFolder": "MS v2\\03 Value",
            "lineageTag": "fefeda44-d169-43ab-9c33-a6c620c81646"
          },
          {
            "name": "Pot Potential Value EUR",
            "expression": [
              "",
              "SUMX (",
              "    VALUES ( dim_terumo_category[terumo_category] ),",
              "    [MS Targetable Units] * [Pot Avg Price EUR]",
              ")",
              ""
            ],
            "formatString": "€#,##0.00;€-#,##0.00;€0.00",
            "displayFolder": "MS v2\\04 Opportunity",
            "lineageTag": "f3404987-4f9d-461e-9c95-7647704ad649"
          },
          {
            "name": "Pot Gap EUR",
            "expression": [
              "",
              "SUMX (",
              "    VALUES ( dim_terumo_category[terumo_category] ),",
              "    [Pot Gap Units] * [Pot Avg Price EUR]",
              ")",
              ""
            ],
            "formatString": "€#,##0.00;€-#,##0.00;€0.00",
            "displayFolder": "MS v2\\04 Opportunity",
            "lineageTag": "d4c1c4b0-bcc4-43e8-a066-c5ebfa441c4b"
          },
          {
            "name": "MS National Realization Pct",
            "description": "National realization rate with customer filter removed. Reference benchmark.",
            "expression": [
              "",
              "CALCULATE (",
              "    [MS Estimated Share %],",
              "    REMOVEFILTERS ( Dim_Cust )",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "MS v2\\02 Benchmark",
            "lineageTag": "f762a700-2d3a-4466-a7ee-62372d33cb84"
          },
          {
            "name": "MS Realization Index",
            "description": "Customer realization vs national average. 100 = average. 150 = 50% above national. Based on REAL customer potential.",
            "expression": [
              "",
              "VAR CurrentRate = [MS Estimated Share %]",
              "VAR BenchmarkRate = [MS Benchmark Share %]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( CurrentRate ) || ISBLANK ( BenchmarkRate ),",
              "        BLANK (),",
              "        ROUND ( DIVIDE ( CurrentRate, BenchmarkRate ) * 100, 0 )",
              "    )",
              ""
            ],
            "formatString": "0",
            "displayFolder": "MS v2\\02 Benchmark",
            "lineageTag": "6b38d96a-2cbc-43ef-8bb7-f8febf340cfa"
          },
          {
            "name": "MS Avg Price by Category",
            "description": "National average selling price per unit in this category. For revenue weighting.",
            "expression": [
              "",
              "DIVIDE (",
              "    CALCULATE ( [Pot Realized Sales EUR], REMOVEFILTERS ( Dim_Cust ) ),",
              "    CALCULATE ( [Pot Realized Qty], REMOVEFILTERS ( Dim_Cust ) )",
              ")"
            ],
            "formatString": "€#,##0.00;€-#,##0.00;€0.00",
            "displayFolder": "MS v2\\03 Value",
            "lineageTag": "4bdf01bc-c501-4c33-bf69-33ae465b3243"
          },
          {
            "name": "MS Category Revenue Share",
            "description": "This category's share of total Terumo revenue. Sums to 100%.",
            "expression": [
              "DIVIDE (",
              "    [Pot Realized Sales EUR],",
              "    CALCULATE (",
              "        [Pot Realized Sales EUR],",
              "        REMOVEFILTERS ( dim_terumo_category )",
              "    )",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "MS v2\\02 Revenue",
            "lineageTag": "0d0244a5-c29e-4b5e-9003-7152e065124c"
          },
          {
            "name": "MS Customer Revenue Share",
            "description": "This customer's share of total Terumo revenue. Sums to 100%.",
            "expression": [
              "DIVIDE (",
              "    [Pot Realized Sales EUR],",
              "    CALCULATE (",
              "        [Pot Realized Sales EUR],",
              "        REMOVEFILTERS ( Dim_Cust )",
              "    )",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "MS v2\\02 Revenue",
            "lineageTag": "0e90bf97-259e-46ae-bd34-a7f654939510"
          },
          {
            "name": "MS Revenue Opportunity",
            "description": "Revenue gap weighted by category importance. High-revenue category gap scores higher.",
            "expression": [
              "",
              "[Pot Gap EUR]",
              ""
            ],
            "formatString": "€#,##0.00;€-#,##0.00;€0.00",
            "displayFolder": "MS v2\\04 Opportunity",
            "lineageTag": "880033a9-16e9-4632-aec8-30dd7b4f6979"
          },
          {
            "name": "MS Customer Category Mix",
            "description": "This customer's spend in this category / their total spend. Sums to 100% per customer.",
            "expression": [
              "VAR CatRev = [Pot Realized Sales EUR]",
              "VAR CustTotalRev =",
              "    CALCULATE (",
              "        [Pot Realized Sales EUR],",
              "        REMOVEFILTERS ( dim_terumo_category )",
              "    )",
              "RETURN",
              "    DIVIDE ( CatRev, CustTotalRev )"
            ],
            "formatString": "0.0%",
            "displayFolder": "MS v2\\03 Customer Strength",
            "lineageTag": "c1e60519-bda1-48aa-8846-1f4437ff7c3b"
          },
          {
            "name": "MS National Category Mix",
            "description": "National revenue split by category. The benchmark mix.",
            "expression": [
              "CALCULATE (",
              "    [MS Category Revenue Share],",
              "    REMOVEFILTERS ( Dim_Cust )",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "MS v2\\03 Customer Strength",
            "lineageTag": "e704c0a1-2a12-45e6-b05f-e91db4d80a3e"
          },
          {
            "name": "MS Mix Index",
            "description": "Customer mix vs national mix. 100 = aligned. 200+ = over-indexed. 0 = whitespace.",
            "expression": [
              "VAR CustMix = [MS Customer Category Mix]",
              "VAR NatMix = [MS National Category Mix]",
              "RETURN",
              "    ROUND ( DIVIDE ( CustMix, NatMix ) * 100, 0 )"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\03 Customer Strength",
            "lineageTag": "82946cc0-c7dd-4055-a547-cd9b8a06a7a6"
          },
          {
            "name": "MS Category Coverage",
            "description": "Categories this customer buys / total categories. No CROSSFILTER needed — Sales_Category joins dim_terumo_category directly.",
            "expression": [
              "VAR CatsBought =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( Sales_Category[Terumo Category] ),",
              "        Sales_Category[Qty Sold] > 0",
              "    )",
              "VAR TotalCats =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( dim_terumo_category[terumo_category] ),",
              "        REMOVEFILTERS ( dim_terumo_category ),",
              "        REMOVEFILTERS ( Dim_Cust )",
              "    )",
              "RETURN",
              "    DIVIDE ( CatsBought, TotalCats )"
            ],
            "formatString": "0%",
            "displayFolder": "MS v2\\03 Customer Strength",
            "lineageTag": "2dce82a3-4891-4dbb-840e-02f2069820af"
          },
          {
            "name": "MS Whitespace Count",
            "description": "Categories with zero sales for this customer.",
            "expression": [
              "VAR TotalCats =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( dim_terumo_category[terumo_category] ),",
              "        REMOVEFILTERS ( dim_terumo_category ),",
              "        REMOVEFILTERS ( Dim_Cust )",
              "    )",
              "VAR CatsBought =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( Sales_Category[Terumo Category] ),",
              "        Sales_Category[Qty Sold] > 0",
              "    )",
              "RETURN",
              "    TotalCats - CatsBought"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\03 Customer Strength",
            "lineageTag": "2f41a025-aca8-4039-a592-f42b0ec0d18e"
          },
          {
            "name": "MS Customer Strength Badge",
            "description": "Champion (150+), Above average (100+), Below average (50+), Growth target (<50).",
            "expression": [
              "VAR RI = [MS Realization Index]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( RI ), BLANK (),",
              "        RI >= 150, \"Champion\",",
              "        RI >= 100, \"Above average\",",
              "        RI >= 50, \"Below average\",",
              "        \"Growth target\"",
              "    )"
            ],
            "displayFolder": "MS v2\\04 Account Priority",
            "lineageTag": "5b39cc2d-42cc-4194-bc51-959a87067d94"
          },
          {
            "name": "MS Customer Action Badge",
            "description": "Protect / Maintain / Monitor / Grow. For scatter chart and table badges.",
            "expression": [
              "VAR RI = [MS Realization Index]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( RI ), BLANK (),",
              "        RI >= 150, \"Protect\",",
              "        RI >= 100, \"Maintain\",",
              "        RI >= 50, \"Monitor\",",
              "        \"Grow\"",
              "    )"
            ],
            "displayFolder": "MS v2\\04 Account Priority",
            "lineageTag": "943ac7a7-c2ca-4b33-98a8-d0db1dc78494"
          },
          {
            "name": "MS Account Priority Score",
            "description": "Customer size rank × whitespace. Large customer + many empty categories = top priority.",
            "expression": [
              "VAR CustRank =",
              "    RANKX (",
              "        ALL ( Dim_Cust[Customer] ),",
              "        [Pot Realized Qty],",
              "        , DESC, DENSE",
              "    )",
              "VAR CustCount =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( Sales_Category[Customer Id] ),",
              "        REMOVEFILTERS ( Dim_Cust )",
              "    )",
              "VAR SizeScore = CustCount - CustRank + 1",
              "VAR Whitespace = [MS Whitespace Count]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( Whitespace ) || Whitespace = 0,",
              "        0,",
              "        SizeScore * Whitespace",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\04 Account Priority",
            "lineageTag": "d32c7d68-6302-420e-a61b-fd8ac6b43e8d"
          },
          {
            "name": "MS Weighted Opportunity Score",
            "description": "Unit gaps weighted by category revenue importance. Revenue-heavy categories dominate.",
            "expression": [
              "",
              "SUMX (",
              "    VALUES ( dim_terumo_category[terumo_category] ),",
              "    [Pot Gap EUR]",
              ")",
              ""
            ],
            "formatString": "€#,##0.00;€-#,##0.00;€0.00",
            "displayFolder": "MS v2\\04 Opportunity",
            "lineageTag": "7a2428a7-9626-4a89-b9c6-05d5630013b9"
          },
          {
            "name": "MS Category Priority Score",
            "description": "Gap × (200 - RI) / 100. Low-realization + high-gap categories rank highest.",
            "expression": [
              "",
              "VAR GapEUR = [Pot Gap EUR]",
              "VAR RI = [MS Realization Index]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( GapEUR ) || ISBLANK ( RI ),",
              "        BLANK (),",
              "        ROUND ( GapEUR * DIVIDE ( MAX ( 0, 150 - RI ), 100, 0 ), 0 )",
              "    )",
              ""
            ],
            "formatString": "€#,##0;€-#,##0;€0",
            "displayFolder": "MS v2\\04 Opportunity",
            "lineageTag": "9b776279-a2d1-4a28-a6e3-dd00c363801f"
          },
          {
            "name": "MS Target RI Value",
            "description": "Reads the what-if slider. Default 100 = national average realization.",
            "expression": "SELECTEDVALUE ( 'Target RI'[Value], 100 )",
            "formatString": "#,##0",
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "455ff94e-cdd4-4857-8bf5-658562d5e344"
          },
          {
            "name": "MS Target RI Label",
            "description": "Dynamic label for visuals.",
            "expression": "\"Units to reach RI \" & FORMAT ( [MS Target RI Value], \"#,##0\" )",
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "7363ca4e-a8dc-4269-ab20-63791a8bc1ea"
          },
          {
            "name": "MS Units to Target",
            "description": "Uses customer-specific potential. A large hospital gets a larger target. RI 100 = reach national avg realization applied to THIS customer's potential.",
            "expression": [
              "VAR TargetRI =",
              "    DIVIDE ( [MS Target RI Value], 100, 1 )",
              "VAR TargetRate =",
              "    [MS Benchmark Share %] * TargetRI",
              "VAR RequiredUnits =",
              "    [Pot Total Potential Units (Latest)] * TargetRate",
              "RETURN",
              "    MAX ( 0, ROUND ( RequiredUnits - [Pot Realized Qty], 0 ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "a111a47a-b3f8-4ca5-9b05-3cd74e6f1ac6"
          },
          {
            "name": "MS Units to Reach RI 50",
            "description": "Units to reach 50% of national avg realization for this customer's potential.",
            "expression": [
              "VAR TargetRate =",
              "    [MS Benchmark Share %] * 0.50",
              "VAR RequiredUnits =",
              "    [Pot Total Potential Units (Latest)] * TargetRate",
              "RETURN",
              "    MAX ( 0, ROUND ( RequiredUnits - [Pot Realized Qty], 0 ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "d25d8dcb-669a-4995-9ef0-dad1e1ad5026"
          },
          {
            "name": "MS Units to Reach RI 75",
            "expression": [
              "VAR TargetRate =",
              "    [MS Benchmark Share %] * 0.75",
              "VAR RequiredUnits =",
              "    [Pot Total Potential Units (Latest)] * TargetRate",
              "RETURN",
              "    MAX ( 0, ROUND ( RequiredUnits - [Pot Realized Qty], 0 ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "44573c92-8e6f-45a8-9d30-20feaddf7d0d"
          },
          {
            "name": "MS Units to Reach RI 100",
            "description": "Units to match national average realization for this customer's specific potential.",
            "expression": [
              "VAR TargetRate =",
              "    [MS Benchmark Share %] * 1.00",
              "VAR RequiredUnits =",
              "    [Pot Total Potential Units (Latest)] * TargetRate",
              "RETURN",
              "    MAX ( 0, ROUND ( RequiredUnits - [Pot Realized Qty], 0 ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "38c62d74-0a9c-47de-bc51-0975ec7b58a5"
          },
          {
            "name": "MS Units to Reach RI 150",
            "description": "Units to become a champion account (1.5× national realization).",
            "expression": [
              "VAR TargetRate =",
              "    [MS Benchmark Share %] * 1.50",
              "VAR RequiredUnits =",
              "    [Pot Total Potential Units (Latest)] * TargetRate",
              "RETURN",
              "    MAX ( 0, ROUND ( RequiredUnits - [Pot Realized Qty], 0 ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "3f116023-c7f3-4a25-b67b-0ab2e12ea0f5"
          },
          {
            "name": "MS Current vs Target Status",
            "description": "Achieved / Near target / Halfway / Below target. For conditional formatting.",
            "expression": [
              "VAR CurrentRI = [MS Realization Index]",
              "VAR TargetRI = [MS Target RI Value]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( CurrentRI ), BLANK (),",
              "        CurrentRI >= TargetRI, \"Achieved\",",
              "        CurrentRI >= TargetRI * 0.75, \"Near target\",",
              "        CurrentRI >= TargetRI * 0.50, \"Halfway\",",
              "        \"Below target\"",
              "    )"
            ],
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "cdd82b95-7fde-42c3-a9d2-ce9918797abe"
          },
          {
            "name": "MS Estimated Share %",
            "expression": [
              "DIVIDE ( [Pot Realized Qty], [Pot Total Potential Units (Latest)] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "MS v2\\01 Core",
            "lineageTag": "b0cf7234-e9d5-4ff6-a029-4fe01022e5d7"
          },
          {
            "name": "MS Benchmark Share %",
            "expression": [
              "",
              "VAR CountrySegmentRate =",
              "    CALCULATE (",
              "        [MS Estimated Share %],",
              "        ALLEXCEPT (",
              "            Dim_Cust,",
              "            Dim_Cust[Country Text],",
              "            Dim_Cust[TIS Final Segmenation]",
              "        )",
              "    )",
              "VAR CountryRate =",
              "    CALCULATE (",
              "        [MS Estimated Share %],",
              "        ALLEXCEPT (",
              "            Dim_Cust,",
              "            Dim_Cust[Country Text]",
              "        )",
              "    )",
              "VAR SegmentRate =",
              "    CALCULATE (",
              "        [MS Estimated Share %],",
              "        ALLEXCEPT (",
              "            Dim_Cust,",
              "            Dim_Cust[TIS Final Segmenation]",
              "        )",
              "    )",
              "VAR NationalRate =",
              "    CALCULATE (",
              "        [MS Estimated Share %],",
              "        REMOVEFILTERS ( Dim_Cust )",
              "    )",
              "VAR ChosenRate =",
              "    COALESCE ( CountrySegmentRate, CountryRate, SegmentRate, NationalRate )",
              "RETURN",
              "    MIN ( 1, ChosenRate )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "MS v2\\02 Benchmark",
            "lineageTag": "38c33d7f-fcd5-4c65-b207-46f96026d181"
          },
          {
            "name": "MS Benchmark Level",
            "expression": [
              "",
              "VAR CountrySegmentRate =",
              "    CALCULATE (",
              "        [MS Estimated Share %],",
              "        ALLEXCEPT (",
              "            Dim_Cust,",
              "            Dim_Cust[Country Text],",
              "            Dim_Cust[TIS Final Segmenation]",
              "        )",
              "    )",
              "VAR CountryRate =",
              "    CALCULATE (",
              "        [MS Estimated Share %],",
              "        ALLEXCEPT (",
              "            Dim_Cust,",
              "            Dim_Cust[Country Text]",
              "        )",
              "    )",
              "VAR SegmentRate =",
              "    CALCULATE (",
              "        [MS Estimated Share %],",
              "        ALLEXCEPT (",
              "            Dim_Cust,",
              "            Dim_Cust[TIS Final Segmenation]",
              "        )",
              "    )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        NOT ISBLANK ( CountrySegmentRate ), \"Country + Segment\",",
              "        NOT ISBLANK ( CountryRate ), \"Country\",",
              "        NOT ISBLANK ( SegmentRate ), \"Segment\",",
              "        \"National\"",
              "    )",
              ""
            ],
            "displayFolder": "MS v2\\02 Benchmark",
            "lineageTag": "13f20d9d-c624-4e7f-b8c1-576dd7f8347b"
          },
          {
            "name": "MS Targetable Units",
            "expression": [
              "[Pot Total Potential Units (Latest)] * [MS Benchmark Share %]"
            ],
            "formatString": "#,##0",
            "displayFolder": "MS v2\\04 Opportunity",
            "lineageTag": "30a6c0c8-574c-4d3c-b82c-b108ccd5741a"
          },
          {
            "name": "MS Action Flag",
            "expression": [
              "",
              "VAR RI = [MS Realization Index]",
              "VAR Gap = [Pot Gap EUR]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( Gap ), BLANK (),",
              "        Gap <= 0, \"Keep Protecting\",",
              "        RI < 80, \"Focus as Priority\",",
              "        RI < 100, \"Capture Potential\",",
              "        \"Optimise Contact\"",
              "    )"
            ],
            "displayFolder": "MS v2\\05 Target",
            "lineageTag": "4fc31c84-f0f9-494c-b0c2-0adb1d1d9180"
          },
          {
            "name": "_Current Sales Year",
            "expression": [
              "MAX ( Sales_Category[Year] )"
            ],
            "lineageTag": "cba7db52-0591-4e8c-aff2-d39f74ee88b3",
            "displayFolder": "MS v2\\00 Helpers",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "_Current Potential Year",
            "expression": [
              "VAR MaxYearInt =",
              "    MAXX ( ALL ( fact_market_potential[year] ), VALUE ( fact_market_potential[year] ) )",
              "RETURN",
              "    FORMAT ( MaxYearInt, \"0\" )"
            ],
            "lineageTag": "d05a562d-9e12-4cd4-b4c9-fcb22710e47c",
            "displayFolder": "MS v2\\00 Helpers",
            "isHidden": true
          },
          {
            "name": "Pot Total Potential Units (Latest)",
            "expression": [
              "VAR LatestYear = [_Current Potential Year]",
              "RETURN",
              "    CALCULATE (",
              "        [Pot Total Potential Units],",
              "        KEEPFILTERS ( fact_market_potential[year] = LatestYear )",
              "    )"
            ],
            "lineageTag": "7e418683-2c75-4a57-a007-a0f2a4434f43",
            "displayFolder": "MS v2\\01 Core",
            "formatString": "#,##0"
          },
          {
            "name": "MS Revenue-Weighted Category Priority",
            "expression": [
              "VAR GapEUR = [Pot Gap EUR]",
              "VAR Share = [MS Estimated Share %]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( GapEUR ),",
              "        BLANK (),",
              "        ROUND ( GapEUR * ( 1 - COALESCE ( Share, 0 ) ), 0 )",
              "    )"
            ],
            "lineageTag": "807c000c-8d8f-4fe6-8602-19b3ee307517",
            "displayFolder": "MS v2\\04 Opportunity",
            "formatString": "#,##0"
          },
          {
            "name": "MS Category Revenue Rank",
            "expression": [
              "IF (",
              "    ISBLANK ( [Pot Realized Sales EUR] ),",
              "    BLANK (),",
              "    RANKX (",
              "        ALL ( dim_terumo_category[terumo_category] ),",
              "        [Pot Realized Sales EUR],",
              "        , DESC, DENSE",
              "    )",
              ")"
            ],
            "lineageTag": "cdf9733d-2c61-424a-9435-a5486e5c9122",
            "displayFolder": "MS v2\\02 Revenue",
            "formatString": "#,##0"
          },
          {
            "name": "MS Customer Revenue Rank",
            "expression": [
              "IF (",
              "    ISBLANK ( [Pot Realized Sales EUR] ),",
              "    BLANK (),",
              "    RANKX (",
              "        ALL ( Dim_Cust[Customer] ),",
              "        [Pot Realized Sales EUR],",
              "        , DESC, DENSE",
              "    )",
              ")"
            ],
            "lineageTag": "b7d45b79-58a1-4fe0-a87e-f916f7a8f569",
            "displayFolder": "MS v2\\02 Revenue",
            "formatString": "#,##0"
          },
          {
            "name": "MS Revenue Concentration Top20",
            "expression": [
              "VAR TotalCustomers =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( Sales_Category[Customer Id] ),",
              "        REMOVEFILTERS ( Dim_Cust ),",
              "        Sales_Category[Qty Sold] > 0",
              "    )",
              "VAR Top20Threshold = ROUNDUP ( TotalCustomers * 0.2, 0 )",
              "VAR Top20Revenue =",
              "    SUMX (",
              "        TOPN (",
              "            Top20Threshold,",
              "            ADDCOLUMNS (",
              "                VALUES ( Dim_Cust[Customer] ),",
              "                \"@rev\", [Pot Realized Sales EUR]",
              "            ),",
              "            [@rev], DESC",
              "        ),",
              "        [@rev]",
              "    )",
              "VAR TotalRevenue =",
              "    CALCULATE ( [Pot Realized Sales EUR], REMOVEFILTERS ( Dim_Cust ) )",
              "RETURN",
              "    DIVIDE ( Top20Revenue, TotalRevenue )"
            ],
            "lineageTag": "83bccc73-3a67-40ae-96cf-3dda73e2de5c",
            "displayFolder": "MS v2\\02 Revenue",
            "formatString": "0.0%"
          },
          {
            "name": "MS Customer Potential Value EUR",
            "expression": [
              "SUMX (",
              "    VALUES ( dim_terumo_category[terumo_category] ),",
              "    [MS Targetable Units] * [Pot Avg Price EUR]",
              ")"
            ],
            "lineageTag": "58d670ae-7e7a-48b0-a948-073c39befc81",
            "displayFolder": "MS v2\\04 Opportunity",
            "formatString": "€#,##0"
          },
          {
            "name": "MS Gap as Pct of Potential",
            "expression": [
              "VAR PotVal =",
              "    SUMX (",
              "        VALUES ( dim_terumo_category[terumo_category] ),",
              "        [MS Targetable Units] * [Pot Avg Price EUR]",
              "    )",
              "RETURN",
              "    DIVIDE ( [Pot Gap EUR], PotVal )"
            ],
            "lineageTag": "092a24e0-9a31-4f00-a819-124020629f88",
            "displayFolder": "MS v2\\04 Opportunity",
            "formatString": "0.0%"
          },
          {
            "name": "MS Customer Priority in Category",
            "expression": [
              "VAR GapUnits = [Pot Gap Units]",
              "VAR RI = [MS Realization Index]",
              "VAR RevShare = [MS Customer Revenue Share]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( GapUnits ) || GapUnits <= 0,",
              "        0,",
              "        ROUND (",
              "            GapUnits",
              "            * COALESCE ( RevShare, 0.01 )",
              "            * DIVIDE ( MAX ( 0, 150 - COALESCE ( RI, 0 ) ), 100, 0 ),",
              "            0",
              "        )",
              "    )"
            ],
            "lineageTag": "22193b7d-b2d2-4510-aa38-359ee34507e3",
            "displayFolder": "MS v2\\06 Category View",
            "formatString": "#,##0"
          },
          {
            "name": "MS Customer Action in Category",
            "expression": [
              "VAR RI = [MS Realization Index]",
              "VAR GapUnits = [Pot Gap Units]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( GapUnits ), BLANK (),",
              "        GapUnits <= 0, \"Fully Penetrated\",",
              "        RI < 50, \"Priority Target\",",
              "        RI < 80, \"Growth Opportunity\",",
              "        RI < 100, \"Capture Remaining\",",
              "        \"Protect Position\"",
              "    )"
            ],
            "lineageTag": "d0340c10-e177-4537-bc33-2d471958a68d",
            "displayFolder": "MS v2\\06 Category View"
          },
          {
            "name": "MS Category Customer Count",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( Sales_Category[Customer Id] ),",
              "    Sales_Category[Qty Sold] > 0",
              ")"
            ],
            "lineageTag": "019523b4-a8d1-4d8b-9bbb-f95b7b303961",
            "displayFolder": "MS v2\\06 Category View",
            "formatString": "#,##0"
          },
          {
            "name": "MS Category Whitespace Customers",
            "expression": [
              "VAR TotalCustomersInScope =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( fact_market_potential[customer_id] ),",
              "        REMOVEFILTERS ( dim_terumo_category )",
              "    )",
              "VAR BuyingCustomers = [MS Category Customer Count]",
              "RETURN",
              "    TotalCustomersInScope - BuyingCustomers"
            ],
            "lineageTag": "ac5e04ef-1382-4299-a7d5-65f005f61298",
            "displayFolder": "MS v2\\06 Category View",
            "formatString": "#,##0"
          },
          {
            "name": "MS Total Addressable Market EUR",
            "expression": [
              "SUMX (",
              "    CROSSJOIN (",
              "        VALUES ( Dim_Cust[Customer] ),",
              "        VALUES ( dim_terumo_category[terumo_category] )",
              "    ),",
              "    [MS Targetable Units] * [Pot Avg Price EUR]",
              ")"
            ],
            "lineageTag": "63918f47-30eb-4c42-a464-adb0fe44f117",
            "displayFolder": "MS v2\\07 Executive",
            "formatString": "€#,##0"
          },
          {
            "name": "MS Portfolio Realization Pct",
            "expression": [
              "DIVIDE (",
              "    [Pot Realized Sales EUR],",
              "    CALCULATE (",
              "        [MS Total Addressable Market EUR],",
              "        REMOVEFILTERS ( Dim_Cust ),",
              "        REMOVEFILTERS ( dim_terumo_category )",
              "    )",
              ")"
            ],
            "lineageTag": "80a2cd31-624c-4ee3-b9ce-327822c9dfff",
            "displayFolder": "MS v2\\07 Executive",
            "formatString": "0.0%"
          },
          {
            "name": "MS Growth Target Account Count",
            "expression": [
              "COUNTROWS (",
              "    FILTER (",
              "        VALUES ( Dim_Cust[Customer] ),",
              "        [MS Realization Index] < 50",
              "            && NOT ISBLANK ( [MS Realization Index] )",
              "    )",
              ")"
            ],
            "lineageTag": "de02d828-75e9-4ace-b869-c11655366e54",
            "displayFolder": "MS v2\\07 Executive",
            "formatString": "#,##0"
          },
          {
            "name": "MS Champion Account Count",
            "expression": [
              "COUNTROWS (",
              "    FILTER (",
              "        VALUES ( Dim_Cust[Customer] ),",
              "        [MS Realization Index] >= 150",
              "    )",
              ")"
            ],
            "lineageTag": "83ffc4d3-0bbb-4ce5-976e-a62485910977",
            "displayFolder": "MS v2\\07 Executive",
            "formatString": "#,##0"
          },
          {
            "name": "MS Total Gap EUR",
            "expression": [
              "SUMX (",
              "    CROSSJOIN (",
              "        VALUES ( Dim_Cust[Customer] ),",
              "        VALUES ( dim_terumo_category[terumo_category] )",
              "    ),",
              "    [Pot Gap EUR]",
              ")"
            ],
            "lineageTag": "2b4eb7df-86d9-4fc4-826b-382c2724f9c8",
            "displayFolder": "MS v2\\07 Executive",
            "formatString": "€#,##0"
          },
          {
            "name": "_CF RI Visual Color",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    [MS Realization Index] < 50, \"#A32D2D\",",
              "    [MS Realization Index] < 80, \"#BA7517\",",
              "    [MS Realization Index] < 100, \"#D4A35A\",",
              "    [MS Realization Index] < 150, \"#639922\",",
              "    \"#1D9E75\"",
              ")"
            ],
            "lineageTag": "25e9d061-fa6d-48e5-819f-9c45da5d1fb5",
            "displayFolder": "MS v2\\00 Helpers",
            "isHidden": true
          },
          {
            "name": "_CF Action Visual Color",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    [MS Action Flag] = \"Focus as Priority\", \"#A32D2D\",",
              "    [MS Action Flag] = \"Capture Potential\", \"#BA7517\",",
              "    [MS Action Flag] = \"Optimise Contact\", \"#185FA5\",",
              "    [MS Action Flag] = \"Keep Protecting\", \"#639922\",",
              "    \"#185FA5\"",
              ")"
            ],
            "lineageTag": "d0fc20fc-3b78-4c91-bb2a-5cb0be15d20c",
            "displayFolder": "MS v2\\00 Helpers",
            "isHidden": true
          },
          {
            "name": "_CF Customer Action Visual Color",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    [MS Customer Action Badge] = \"Grow\", \"#A32D2D\",",
              "    [MS Customer Action Badge] = \"Monitor\", \"#BA7517\",",
              "    [MS Customer Action Badge] = \"Maintain\", \"#185FA5\",",
              "    [MS Customer Action Badge] = \"Protect\", \"#639922\",",
              "    \"#185FA5\"",
              ")"
            ],
            "lineageTag": "d4ed7003-5269-4037-b366-2941b75f7610",
            "displayFolder": "MS v2\\00 Helpers",
            "isHidden": true
          },
          {
            "name": "_CF Target Status Visual Color",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    [MS Current vs Target Status] = \"Below target\", \"#A32D2D\",",
              "    [MS Current vs Target Status] = \"Halfway\", \"#BA7517\",",
              "    [MS Current vs Target Status] = \"Near target\", \"#D4A35A\",",
              "    [MS Current vs Target Status] = \"Achieved\", \"#639922\",",
              "    \"#185FA5\"",
              ")"
            ],
            "lineageTag": "9d97c533-2386-4882-92f3-49d665685da2",
            "displayFolder": "MS v2\\00 Helpers",
            "isHidden": true
          },
          {
            "name": "_CF Gap Visual Color",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    [Pot Gap EUR] <= 0, \"#639922\",",
              "    [Pot Gap EUR] < 50000, \"#D4A35A\",",
              "    [Pot Gap EUR] < 250000, \"#BA7517\",",
              "    \"#A32D2D\"",
              ")"
            ],
            "lineageTag": "834e1b22-7223-4105-8bd2-59e0a8f97723",
            "displayFolder": "MS v2\\00 Helpers",
            "isHidden": true
          }
        ],
