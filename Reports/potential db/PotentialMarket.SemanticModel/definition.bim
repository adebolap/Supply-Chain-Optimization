            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Security Cost",
            "mode": "import",
            "queryGroup": "6. Security",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = SharePoint.Files(Sharepoint, [ApiVersion = 15]),",
                "    #\"00  Dim_SalesRep_Hierarchy xlsx_https://terumoemea sharepoint com/teams/TISSalesGPReport/Shared Documents/\" = Source{[Name=\"05. Security Cost.xlsx\",#\"Folder Path\"=Folder]}[Content],",
                "    #\"Imported Excel\" = Excel.Workbook(#\"00  Dim_SalesRep_Hierarchy xlsx_https://terumoemea sharepoint com/teams/TISSalesGPReport/Shared Documents/\"),",
                "    Sheet1_Sheet = #\"Imported Excel\"{[Item=\"Sheet1\",Kind=\"Sheet\"]}[Data],",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true]),",
                "    #\"Removed Other Columns\" = Table.SelectColumns(#\"Promoted Headers\",{\"email\"}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Removed Other Columns\", each ([email] <> null)),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Filtered Rows\"),",
                "    #\"Removed Errors\" = Table.RemoveRowsWithErrors(#\"Removed Duplicates\")",
                "in",
                "    #\"Removed Errors\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
