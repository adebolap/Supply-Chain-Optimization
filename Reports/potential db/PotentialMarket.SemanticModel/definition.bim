          "    #\"Imported Excel\" = Excel.Workbook(#\"00  Dim_Product_Hierarchy xlsx_https://terumoemea sharepoint com/teams/TISSalesGPReport/Shared Documents/\"),",
          "    Dim_Product_Hierarchy_Sheet = #\"Imported Excel\"{[Item=\"Dim_Product_Hierarchy\",Kind=\"Sheet\"]}[Data],",
          "    #\"Promoted Headers\" = Table.PromoteHeaders(Dim_Product_Hierarchy_Sheet, [PromoteAllScalars=true]),",
          "    #\"Uppercased Text\" = Table.TransformColumns(#\"Promoted Headers\",{{\"Product Group Text\", Text.Upper, type text}, {\"Product Subgroup Text\", Text.Upper, type text}, {\"Product Group 3\", Text.Upper, type text}, {\"Product Group 2\", Text.Upper, type text}}),",
          "    #\"Removed Other Columns\" = Table.SelectColumns(#\"Uppercased Text\",{\"Business Unit Text\", \"Business Line Text\", \"Product Area Text\", \"Product Group Text\", \"Product Subgroup Text\", \"Product Area Code\", \"Profit Center\", \"Profit Center 2\", \"Profit Center 3\", \"Product Area\", \"Product Group 1\", \"Product Group 2\", \"Product Group 3\"})",
          "in",
