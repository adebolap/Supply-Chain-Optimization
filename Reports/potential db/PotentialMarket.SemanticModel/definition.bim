          {
            "name": "FY Sales LY",
            "description": [
              "Calculates the previous FY sum of net sales based on view and currency selected",
              ""
            ],
            "expression": [
              "",
              "SWITCH(",
              "  TRUE(),",
              "  AND(min('Button €/LC'[ID])=1,min('Button FiscalYTD'[ID])=2),CALCULATE(SUM('DATA'[Net Sales Actual (EUR)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscLY]),Dim_Cal[IsFiscLY]=1)),",
              "  AND(min('Button €/LC'[ID])=2,min('Button FiscalYTD'[ID])=2),CALCULATE(SUM('DATA'[Net Sales Actual (LC)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscLY]),Dim_Cal[IsFiscLY]=1)),",
              "  AND(min('Button €/LC'[ID])=1,min('Button FiscalYTD'[ID])=1),CALCULATE(SUM('DATA'[Net Sales Actual (EUR)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscYTD]),Dim_Cal[IsFiscYTD]=TRUE),FILTER( VALUES('Dim_Cal'[IsFiscLY]),Dim_Cal[IsFiscLY]=1)),",
              "  AND(min('Button €/LC'[ID])=2,min('Button FiscalYTD'[ID])=1),CALCULATE(SUM('DATA'[Net Sales Actual (LC)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscYTD]),Dim_Cal[IsFiscYTD]=TRUE),FILTER(VALUES('Dim_Cal'[IsFiscLY]),Dim_Cal[IsFiscLY]=1)))"
            ],
            "formatString": "#,0",
            "displayFolder": "1.B FY Figures for Selected Period",
            "lineageTag": "3b85c999-b4f3-4403-afcf-1af713881243"
          },
