        "partitions": [
          {
            "name": "Period",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                " VAR ",
                "    _last30days = ADDCOLUMNS(",
                "        CALCULATETABLE('Dim_Cal',DATESBETWEEN(Dim_Cal[Date],TODAY() - 30,TODAY()))",
                "        ,\"In the last\",\"30 days\"",
                "        )",
                "VAR   _last60days = ADDCOLUMNS(",
                "        CALCULATETABLE('Dim_Cal',DATESBETWEEN(Dim_Cal[Date],TODAY() - 60,TODAY()))",
                "        ,\"In the last\",\"60 days\"",
                "        )",
                "VAR    _last90days = ADDCOLUMNS(",
                "        CALCULATETABLE('Dim_Cal',DATESBETWEEN(Dim_Cal[Date],TODAY() - 90,TODAY()))",
                "        ,\"In the last\",\"90 days\"",
                "        )",
                "    Return UNION(_last30days,_last60days,_last90days)"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "82dcef3f5ff34e4bb3e2967ecc406389"
          }
        ]
      },
      {
        "name": "Security Cost",
        "lineageTag": "3cdecf70-8c56-478d-85a2-fcf68b702a02",
        "columns": [
          {
            "name": "email",
