        "measures": [
          {
            "name": "Selected Products",
            "expression": [
              "IF (",
              "ISFILTERED ( 'Dim_Cal'[MMM] ),",
              "CONCATENATEX ( FILTERS ( 'Dim_Cal'[MMM] ), 'Dim_Cal'[MMM], \",\" ),",
