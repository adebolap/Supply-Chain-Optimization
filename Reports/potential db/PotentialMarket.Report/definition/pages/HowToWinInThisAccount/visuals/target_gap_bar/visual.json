{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "target_gap_bar",
  "position": {
    "x": 16,
    "y": 468,
    "z": 0,
    "height": 196,
    "width": 668,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "stackedBarChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_terumo_category"
                    }
                  },
                  "Property": "terumo_category"
                }
              },
              "queryRef": "dim_terumo_category.terumo_category",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_market_potential"
                    }
                  },
                  "Property": "Pot Realized Qty"
                }
              },
              "queryRef": "Sum(fact_market_potential.Pot Realized Qty)",
              "active": true
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_market_potential"
                    }
                  },
                  "Property": "MS Units to Target"
                }
              },
              "queryRef": "Sum(fact_market_potential.MS Units to Target)",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Current vs gap to target'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  }
}