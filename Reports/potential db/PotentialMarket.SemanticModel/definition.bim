          {
            "name": "FY GP Plan",
            "description": "Calculates the current FY Gross Profit Plan ",
            "expression": "IF(COUNTROWS('Security Cost') =1 || AND(NOT(ISFILTERED(Dim_Product[Material Code & Name])),AND(NOT(ISFILTERED(Dim_Product[Product Group 2])),NOT(ISFILTERED(Dim_Product[Product Group 3])))),[FY Sales Plan]-[FY DC Plan],blank())",
            "formatString": "#,0",
            "displayFolder": "1.B FY Figures for Selected Period",
            "lineageTag": "570e5bfe-ace7-4cc1-aaae-39693b9f974b"
          },
          {
            "name": "FY GP% CY",
            "description": "Calculates the gross profit % for current FY ( Total sales / Total deemed cost ) ",
            "expression": "DIVIDE([FY GP CY],[FY Sales CY],Blank())",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "1.A Fiscal Year Measure Comparison (select period)",
            "lineageTag": "686e1063-249f-4f70-a1c8-8d5854d94011"
          },
          {
            "name": "FY GP% LY",
            "description": "Calculates the Gross Profit % of previous FY ",
            "expression": "DIVIDE([FY GP LY],[FY Sales LY],Blank())",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "1.B FY Figures for Selected Period",
            "lineageTag": "87654d17-35fd-4a03-ae15-010ae31936c4"
          },
          {
            "name": "FY GP% LY2",
            "description": "Calculates the Gross Profit % of FY from 2 years ago ",
            "expression": "DIVIDE([FY GP LY2],[FY Sales LY2],Blank()) ",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "1.B FY Figures for Selected Period",
            "lineageTag": "3023b911-39cc-4e15-93a3-a97c328f9d82"
          },
          {
            "name": "FY GP% Plan",
            "description": "Calculates the current FY Gross Profit% Plan ",
            "expression": "DIVIDE([FY GP Plan],[FY Sales Plan],Blank())",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "1.B FY Figures for Selected Period",
            "lineageTag": "57ec01de-a24c-4538-9884-6969ab6d27e4"
          },
          {
            "name": "FY Sales CY",
            "description": "Calculates the sum of current FY Net sales based on view and currency selected",
            "expression": [
              "",
              "CALCULATE(",
              "    SWITCH(",
              "        TRUE(),",
              "        AND(min('Button €/LC'[ID])=1, min('Button FiscalYTD'[ID])=2), SUM('DATA'[Net Sales Actual (EUR)]),",
              "        AND(min('Button €/LC'[ID])=2, min('Button FiscalYTD'[ID])=2), SUM('DATA'[Net Sales Actual (LC)]),",
              "        AND(min('Button €/LC'[ID])=1, min('Button FiscalYTD'[ID])=1), SUM('DATA'[Net Sales Actual (EUR)]),",
              "        AND(min('Button €/LC'[ID])=2, min('Button FiscalYTD'[ID])=1), SUM('DATA'[Net Sales Actual (LC)])",
              "    ) / Scalling[SelectedScaling],",
              "    VALUES('Dim_Cal'[IsFiscYTD]),",
              "    VALUES('Dim_Cal'[IsFiscCY]),",
              "    Dim_Cal[IsFiscYTD]=TRUE && Dim_Cal[IsFiscCY]=TRUE",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "1.A Fiscal Year Measure Comparison (select period)",
            "lineageTag": "dd3fff65-6275-4dc7-87db-87ac4f11144c"
          },
          {
            "name": "FY GP% vsLY2",
            "description": "Calculates the difference between Current FY Gross Profit % Vs FY Gross Profit %  from 2 years ago",
            "expression": "[FY GP% CY] - [FY GP% LY2]",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "1.B FY Figures for Selected Period",
            "lineageTag": "88791ffe-c87d-4256-9d8e-04c0058ec101"
          },
          {
            "name": "FY GP% vsLY2%",
            "description": [
              "Calculates the growth of current FY Gross Profit % Vs FY Gross Profit %  from 2 years ago (variance in %)",
              ""
            ],
            "expression": [
              "VAR _cy = [FY GP% CY]",
              "VAR _comp = [FY GP% LY2]",
              "RETURN",
              "IF(ISBLANK(_comp), BLANK(), DIVIDE(_cy, _comp, BLANK()) - 1)"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "1.B FY Figures for Selected Period",
