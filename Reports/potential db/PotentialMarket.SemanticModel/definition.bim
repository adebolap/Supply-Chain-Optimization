          },
          {
            "name": "FY DC CY",
            "description": "Current FY Deemed Cost. Respects currency selection and YTD toggle.",
            "expression": [
              "VAR _cur = SELECTEDVALUE('Button €/LC'[ID], 1)",
              "VAR _ytd = SELECTEDVALUE('Button FiscalYTD'[ID], 2)",
              "VAR _base =",
              "    SWITCH(",
              "        TRUE(),",
              "        _cur = 1, SUM('DATA'[Deemed Cost Actual (EUR)]),",
              "        _cur = 2, SUM('DATA'[Deemed Cost Actual (LC)])",
              "    )",
              "RETURN",
              "IF(",
              "    _ytd = 1,",
              "    CALCULATE(",
              "        _base / [SelectedScaling],",
              "        FILTER(VALUES('Dim_Cal'[IsFiscCY]),  Dim_Cal[IsFiscCY]  = TRUE),",
              "        FILTER(VALUES('Dim_Cal'[IsFiscYTD]), Dim_Cal[IsFiscYTD] = TRUE)",
              "    ),",
              "    CALCULATE(",
              "        _base / [SelectedScaling],",
              "        FILTER(VALUES('Dim_Cal'[IsFiscCY]), Dim_Cal[IsFiscCY] = TRUE)",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "1.A Fiscal Year Measure Comparison (select period)",
            "lineageTag": "7cacedf0-003c-4c21-baab-bead15d58826"
          },
          {
            "name": "FY DC LY",
            "description": "Calculates the sum of previous FY Deemed cost based on view and currency selected",
            "expression": [
