          {
            "type": "calculated",
            "name": "ProductFamily",
            "dataType": "string",
            "description": "Maps SKU to DNA product family. GWA Track → Glidewire Advantage.",
            "expression": [
              "",
              "VAR _pst = Dim_Product[Product Subgroup Text]",
              "RETURN",
              "SWITCH (",
              "    TRUE (),",
              "",
              "    -- Destination",
              "    _pst = \"DESTINATION\",",
              "        \"Destination\",",
              "",
              "    -- NaviCross",
              "    _pst IN { \"NAVICROSS 035\", \"NAVICROSS 018\" },",
              "        \"NaviCross\",",
              "",
              "    -- Glidewire Advantage (all GW subgroups)",
              "    _pst IN {",
              "        \"GW ADVANTAGE .014\",",
              "        \"GW ADVANTAGE .014 YAMAGUCHI\",",
              "        \"GW ADVANTAGE .018\",",
              "        \"GW ADVANTAGE .018 YAMAGUCHI\",",
              "        \"GW ADVANTAGE .035\",",
              "        \"GW ADVANTAGE TRACK.014\",",
              "        \"GW ADVANTAGE TRACK.018\",",
              "        \"GW OTHERS\"",
              " ",
              "    },",
              "        \"Glidewire Advantage Family\",",
              "",
              "    -- Everything else",
              "    \"Other\"",
              ")"
            ],
            "displayFolder": "DNA Classification",
            "lineageTag": "09c4fcff-0cdf-4990-a51f-f16eb124784c",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "IsDNAProduct",
            "dataType": "boolean",
            "description": "TRUE for Destination, NaviCross, or Glidewire Advantage SKUs.",
            "expression": [
              "",
              "Dim_Product[Product Subgroup Text] IN {",
              "    \"DESTINATION\",",
              "    \"NAVICROSS 035\",",
              "    \"NAVICROSS 018\",",
              "    \"GW ADVANTAGE .014\",",
              "    \"GW ADVANTAGE .014 YAMAGUCHI\",",
              "    \"GW ADVANTAGE .018\",",
              "    \"GW ADVANTAGE .018 YAMAGUCHI\",",
              "    \"GW ADVANTAGE .035\",",
              "    \"GW ADVANTAGE TRACK.014\",",
              "    \"GW ADVANTAGE TRACK.018\",",
              "    \"GW OTHERS\"",
              "}"
            ],
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "displayFolder": "DNA Classification",
            "lineageTag": "03e28413-5f12-4b0b-8713-ce3b2efcabf4",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "IsGWATrack",
            "dataType": "boolean",
            "description": "TRUE for GWA Track SKUs only. These roll into Glidewire Advantage family.",
            "expression": "CONTAINSSTRING ( Dim_Product[Product Group 3], \"ADVANTAGE\" )",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "displayFolder": "DNA Classification",
            "lineageTag": "fc8a1f02-41a4-47f3-bc84-e72c4a571bcf",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Dim_Product-7941fa69-9ce0-4729-a4c9-336a52c807a7",
            "mode": "import",
            "queryGroup": "2. Product Dimension",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PowerBI.Dataflows(null),",
                "    #\"cb3543d9-1b55-42ea-8443-b7363fd1245c\" = Source{[workspaceId=\"cb3543d9-1b55-42ea-8443-b7363fd1245c\"]}[Data],",
                "    #\"a5198f3c-5a75-40bb-be57-fc3d39a50173\" = #\"cb3543d9-1b55-42ea-8443-b7363fd1245c\"{[dataflowId=\"a5198f3c-5a75-40bb-be57-fc3d39a50173\"]}[Data],",
                "    #\"SAP 0MATERIAL1\" = #\"a5198f3c-5a75-40bb-be57-fc3d39a50173\"{[entity=\"SAP 0MATERIAL\"]}[Data],",
                "",
                "    #\"Removed Other Columns\" =",
                "        Table.SelectColumns(",
                "            #\"SAP 0MATERIAL1\",",
                "            {",
                "                \"Material Description\",",
                "                \"Business Unit Text\",",
                "                \"Business Line Text\",",
                "                \"Product Area Text\",",
                "                \"Product Group Text\",",
                "                \"Product Subgroup Text\",",
                "                \"Material\",",
                "                \"Product Hierarchy\"",
                "            }",
                "        ),",
                "",
                "    #\"Uppercased Text\" =",
                "        Table.TransformColumns(",
                "            #\"Removed Other Columns\",",
                "            {",
                "                {\"Product Subgroup Text\", Text.Upper, type text},",
                "                {\"Product Group Text\", Text.Upper, type text},",
                "                {\"Product Area Text\", Text.Upper, type text}",
                "            }",
                "        ),",
                "",
                "    #\"Appended Query\" = Table.Combine({#\"Uppercased Text\", Shp_MissingMaterial}),",
                "",
                "    #\"Merged Queries\" =",
                "        Table.NestedJoin(",
                "            #\"Appended Query\",",
                "            {\"Business Line Text\", \"Product Area Text\", \"Product Group Text\", \"Product Subgroup Text\"},",
                "            Shp_Dim_Product_Hierarchy,",
                "            {\"Business Line Text\", \"Product Area Text\", \"Product Group Text\", \"Product Subgroup Text\"},",
                "            \"Shp_Dim_Product_Hierarchy\",",
                "            JoinKind.LeftOuter",
                "        ),",
                "",
                "    #\"Expanded Shp_Dim_Product_Hierarchy\" =",
                "        Table.ExpandTableColumn(",
                "            #\"Merged Queries\",",
                "            \"Shp_Dim_Product_Hierarchy\",",
                "            {\"Product Area Code\", \"Profit Center\", \"Profit Center 2\", \"Profit Center 3\", \"Product Area\", \"Product Group 1\", \"Product Group 2\", \"Product Group 3\"},",
                "            {\"Shp_Dim_Product_Hierarchy.Product Area Code\", \"Shp_Dim_Product_Hierarchy.Profit Center\", \"Shp_Dim_Product_Hierarchy.Profit Center 2\", \"Shp_Dim_Product_Hierarchy.Profit Center 3\", \"Shp_Dim_Product_Hierarchy.Product Area\", \"Shp_Dim_Product_Hierarchy.Product Group 1\", \"Shp_Dim_Product_Hierarchy.Product Group 2\", \"Shp_Dim_Product_Hierarchy.Product Group 3\"}",
                "        ),",
                "",
                "    #\"Renamed Columns\" =",
                "        Table.RenameColumns(",
                "            #\"Expanded Shp_Dim_Product_Hierarchy\",",
                "            {",
                "                {\"Shp_Dim_Product_Hierarchy.Product Area Code\", \"Product Area Code\"},",
                "                {\"Shp_Dim_Product_Hierarchy.Profit Center\", \"Profit Center\"},",
                "                {\"Shp_Dim_Product_Hierarchy.Profit Center 2\", \"Profit Center 2\"},",
                "                {\"Shp_Dim_Product_Hierarchy.Profit Center 3\", \"Profit Center 3\"},",
                "                {\"Shp_Dim_Product_Hierarchy.Product Area\", \"Product Area\"},",
                "                {\"Shp_Dim_Product_Hierarchy.Product Group 1\", \"Product Group 1\"},",
                "                {\"Shp_Dim_Product_Hierarchy.Product Group 2\", \"Product Group 2\"},",
                "                {\"Shp_Dim_Product_Hierarchy.Product Group 3\", \"Product Group 3\"},",
                "                {\"Product Hierarchy\", \"Product Hierarchy Code\"}",
                "            }",
                "        ),",
                "",
                "    // ============================================================",
                "    // Hardcoded hierarchy rows",
                "    // - Material = Product Subgroup Text",
                "    // - Unavailable fields set to \"Not Assigned\"",
                "    // - Dedup on a normalized composite key",
                "    // ============================================================",
                "",
                "    Normalize = (x as any) as text =>",
                "        let",
                "            t0 = if x = null then \"\" else Text.From(x),",
                "            t1 = Text.Upper(Text.Trim(t0)),",
                "            t2 = Text.Combine(List.Select(Text.Split(t1, \" \"), each _ <> \"\"), \" \")",
                "        in",
                "            t2,",
                "",
                "    HardKey = (r as record) as text =>",
                "        Normalize(Record.FieldOrDefault(r, \"Business Unit Text\")) & \"|\" &",
                "        Normalize(Record.FieldOrDefault(r, \"Business Line Text\")) & \"|\" &",
                "        Normalize(Record.FieldOrDefault(r, \"Product Area Text\")) & \"|\" &",
                "        Normalize(Record.FieldOrDefault(r, \"Product Group Text\")) & \"|\" &",
                "        Normalize(Record.FieldOrDefault(r, \"Product Subgroup Text\")),",
                "",
                "    HardcodedHierarchyRaw =",
                "        #table(",
                "            type table [",
                "                #\"Business Unit Text\" = text,",
                "                #\"Business Line Text\" = text,",
                "                #\"Product Area Text\" = text,",
                "                #\"Product Group Text\" = text,",
                "                #\"Product Subgroup Text\" = text,",
                "                #\"Product Area Code\" = text,",
                "                #\"Profit Center\" = text,",
                "                #\"Profit Center 2\" = text,",
                "                #\"Profit Center 3\" = text,",
                "                #\"Product Area\" = text,",
                "                #\"Product Group 1\" = text,",
                "                #\"Product Group 2\" = text,",
                "                #\"Product Group 3\" = text,",
                "                Material = text,",
                "                #\"Material Description\" = text,",
                "                #\"Product Hierarchy Code\" = text",
                "            ],",
                "            {",
                "                {\"TIS\",\"ISCD\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC10010\",\"0101\",\"CARDIO\",\"Core\",\"CARDIO\",\"INTERVENTIONAL CARDIO OTHERS\",\"INTERVENT. CARDIO OTHERS\",\"INTERV. CARD. OTHERS\",\"INTERV. CARD. OTHERS\",\"PC10010\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISCD\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC10020\",\"0101\",\"CARDIO\",\"Core\",\"CARDIO\",\"INTERVENTIONAL CARDIO OTHERS\",\"INTERVENT. CARDIO OTHERS\",\"INTERV. CARD. OTHERS\",\"INTERV. CARD. OTHERS\",\"PC10020\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISCD\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC10101\",\"0101\",\"CARDIO\",\"Core\",\"CARDIO\",\"INTERVENTIONAL CARDIO OTHERS\",\"INTERVENT. CARDIO OTHERS\",\"INTERV. CARD. OTHERS\",\"INTERV. CARD. OTHERS\",\"PC10101\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISCD\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC10102\",\"0101\",\"CARDIO\",\"Core\",\"CARDIO\",\"INTERVENTIONAL CARDIO OTHERS\",\"INTERVENT. CARDIO OTHERS\",\"INTERV. CARD. OTHERS\",\"INTERV. CARD. OTHERS\",\"PC10102\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISCD\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC10103\",\"0101\",\"CARDIO\",\"Core\",\"CARDIO\",\"INTERVENTIONAL CARDIO OTHERS\",\"INTERVENT. CARDIO OTHERS\",\"INTERV. CARD. OTHERS\",\"INTERV. CARD. OTHERS\",\"PC10103\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISCD\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC10110\",\"0101\",\"CARDIO\",\"Core\",\"CARDIO\",\"INTERVENTIONAL CARDIO OTHERS\",\"INTERVENT. CARDIO OTHERS\",\"INTERV. CARD. OTHERS\",\"INTERV. CARD. OTHERS\",\"PC10110\",\"Not Assigned\",\"Not Assigned\"},",
                "",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC11010\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC11010\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC11030\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC11030\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC11101\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC11101\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC11102\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC11102\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC11103\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC11103\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC11104\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC11104\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC11105\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC11105\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC11110\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC11110\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC12110\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC12110\",\"Not Assigned\",\"Not Assigned\"},",
                "                {\"TIS\",\"ISEV\",\"NOT ASSIGNED\",\"NOT ASSIGNED\",\"PC19099\",\"0102\",\"EVI\",\"Core\",\"PI\",\"ANGIO\",\"ANGIO OTHERS\",\"ENDOVASC CORR\",\"ENDOVASC CORR\",\"PC19099\",\"Not Assigned\",\"Not Assigned\"}",
                "            }",
                "        ),",
                "",
                "    // Normalize/dedup hardcoded rows by key (keeps first)",
                "    HardcodedWithKey = Table.AddColumn(HardcodedHierarchyRaw, \"__k\", each HardKey(_), type text),",
