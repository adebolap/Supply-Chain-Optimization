          {
            "name": "Portfolio Category 2",
            "dataType": "string",
            "sourceColumn": "Portfolio Category 2",
            "lineageTag": "55178b80-f211-47cc-8d29-9661caf1e960",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
