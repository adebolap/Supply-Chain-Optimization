          {
            "type": "calculated",
            "name": "IsFiscCY",
            "dataType": "boolean",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR lastmonth = MONTH(TODAY())",
              "VAR CalendarYearinFiscalYear = if(lastmonth<=3,year(TODAY())-1, year(TODAY()))",
              "Return",
              "'Dim_Cal'[Fiscal Year] = CalendarYearinFiscalYear"
            ],
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "e58d6f2d-20ed-4c04-a1c3-6a6b252fb167",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "IsFiscYTD",
            "dataType": "boolean",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "Var month = Dim_Cal[Fiscal Month]",
              "Return",
              "IF(month <= if(MONTH(today())<=3,MONTH(TODAY())+9,MONTH(TODAY())-3),true(),false())"
            ],
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "e38ea328-4247-4164-aae7-f0004c87c377",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "IsFiscLY",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR LastMonth = MONTH(TODAY())",
              "VAR LastYear = YEAR(TODAY())-1",
              "VAR CalendarYearInFiscalYear = IF(LastMonth <=3 , LastYear - 1 , LastYear)",
              "RETURN",
              "IF('Dim_Cal'[Fiscal Year]=CalendarYearInFiscalYear , 1 , 0)"
            ],
            "formatString": "0",
            "lineageTag": "b06555eb-d5ee-4de9-a00a-dbf98177ea5d",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
