              "  AND(min('Button €/LC'[ID])=2,min('Button FiscalYTD'[ID])=2),CALCULATE(SUM('DATA'[Net Sales Actual (LC)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscLY2]),Dim_Cal[IsFiscLY2]=1)),",
