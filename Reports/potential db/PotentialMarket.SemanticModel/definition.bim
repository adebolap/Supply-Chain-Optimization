              "   AND(min('Button €/LC'[ID])=1,min('Button CalYTD'[ID])=1),CALCULATE(SUM('DATA'[Net Sales Qty Actual]),FILTER(VALUES('Dim_Cal'[IsCalYTD]),Dim_Cal[IsCalYTD]=TRUE),FILTER(VALUES('Dim_Cal'[IsCalLY2]),Dim_Cal[IsCalLY2]=1)),",
              "   AND(min('Button €/LC'[ID])=2,min('Button CalYTD'[ID])=1),CALCULATE(SUM('DATA'[Net Sales Qty Actual]),FILTER(VALUES('Dim_Cal'[IsCalYTD]),Dim_Cal[IsCalYTD]=TRUE),FILTER(VALUES('Dim_Cal'[IsCalLY2]),Dim_Cal[IsCalLY2]=1)))"
