          {
            "name": "OIH Sales",
            "description": "Calculates the sum of order in hand amount based on view and currency selected",
            "expression": [
              "VAR _cur = SELECTEDVALUE('Button €/LC'[ID], 1)",
              "VAR _oih = SELECTEDVALUE('Button OIH'[ID], 2)",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    _cur = 1 && _oih = 2, CALCULATE( SUM('DATA'[OIH Amt (EUR)]) ),",
              "    _cur = 2 && _oih = 2, CALCULATE( SUM('DATA'[OIH Amt]) ),",
              "    _cur = 1 && _oih = 1,",
              "        CALCULATE( SUM('DATA'[OIH Amt (EUR)]), FILTER( ALL('Dim_Cal'), Dim_Cal[IsUntil Today] = TRUE ) ),",
              "    _cur = 2 && _oih = 1,",
              "        CALCULATE( SUM('DATA'[OIH Amt]), FILTER( ALL('Dim_Cal'), Dim_Cal[IsUntil Today] = TRUE ) )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "928054b0-6d9a-4e26-bddd-2daab15123fc",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "OIH Qty",
            "description": "Order In Hand quantity. ID=2: all OIH. ID=1: up to today only. Currency-agnostic.",
            "expression": [
              "VAR _oih = SELECTEDVALUE('Button OIH'[ID], 2)",
              "RETURN",
              "IF(",
              "    _oih = 2,",
              "    CALCULATE( SUM('DATA'[OIH Qty]) ),",
              "    CALCULATE( SUM('DATA'[OIH Qty]), FILTER( ALL('Dim_Cal'), Dim_Cal[IsUntil Today] = TRUE ) )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "dbde4d4b-0691-4d22-9668-631f0c5caae9",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "List_Filter",
            "description": "Summarizes which filters have been selected to view the report, implemented for user friendly purpose ",
            "expression": [
              "",
              "VAR MaxFilters = 5",
              "RETURN",
              "IF ( ",
              "    ISFILTERED ( Dim_Cal[MMM] ), ",
              "    VAR ___f = FILTERS ( Dim_Cal[MMM]) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, Dim_Cal[MMM] )",
              "    VAR ___d = CONCATENATEX ( ___t, Dim_Cal[MMM], \", \" )",
              "    VAR ___x = \"Months = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ")",
              "& IF ( ",
              "    ISFILTERED ( Dim_Product[Profit Center 2] ), ",
              "    VAR ___f = FILTERS (Dim_Product[Profit Center 2] ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, Dim_Product[Profit Center 2]  )",
              "    VAR ___d = CONCATENATEX ( ___t, Dim_Product[Profit Center 2] , \", \" )",
              "    VAR ___x = \"Business Line = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ")",
              "& IF ( ",
              "    ISFILTERED ( DATA[Final Destinatin Combined] ), ",
              "    VAR ___f = FILTERS (DATA[Final Destinatin Combined] ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, DATA[Final Destinatin Combined]  )",
              "    VAR ___d = CONCATENATEX ( ___t, DATA[Final Destinatin Combined] , \", \" )",
              "    VAR ___x = \"Final Dest = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ")",
              "& IF ( ",
              "    ISFILTERED ( Dim_Cust[Country] ), ",
              "    VAR ___f = FILTERS (Dim_Cust[Country] ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, Dim_Cust[Country] )",
              "    VAR ___d = CONCATENATEX ( ___t, Dim_Cust[Country] , \", \" )",
              "    VAR ___x = \"Country = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ")",
              "& IF ( ",
              "    ISFILTERED ( Dim_Product[Product Area Text] ), ",
              "    VAR ___f = FILTERS (Dim_Product[Product Area Text] ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, Dim_Product[Product Area Text])",
              "    VAR ___d = CONCATENATEX ( ___t, Dim_Product[Product Area Text] , \", \" )",
              "    VAR ___x = \"Product Area = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ")",
              " & IF ( ",
              "    ISFILTERED ( Dim_Product[Product Group 1] ), ",
              "    VAR ___f = FILTERS ( Dim_Product[Product Group 1] ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, Dim_Product[Product Group 1] )",
              "    VAR ___d = CONCATENATEX ( ___t, Dim_Product[Product Group 1], \", \" )",
              "    VAR ___x = \"Product Group = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ") ",
              " & IF ( ",
              "    ISFILTERED ( Dim_Product[Product Group 3] ), ",
              "    VAR ___f = FILTERS ( Dim_Product[Product Group 3] ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, Dim_Product[Product Group 3] )",
              "    VAR ___d = CONCATENATEX ( ___t, Dim_Product[Product Group 3], \", \" )",
              "    VAR ___x = \"Product Sub-Group = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ") ",
              " & IF ( ",
              "    ISFILTERED ( DATA[Final_Material] ), ",
              "    VAR ___f = FILTERS ( DATA[Final_Material] ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, DATA[Final_Material] )",
              "    VAR ___d = CONCATENATEX ( ___t, DATA[Final_Material], \", \" )",
              "    VAR ___x = \"Material = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ") ",
              " & IF ( ",
              "    ISFILTERED ( Dim_Cust[Customer Combined] ), ",
              "    VAR ___f = FILTERS ( Dim_Cust[Customer Combined]  ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, Dim_Cust[Customer Combined]  )",
              "    VAR ___d = CONCATENATEX ( ___t, Dim_Cust[Customer Combined] , \", \" )",
              "    VAR ___x = \"Customer = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ")",
              " & IF ( ",
              "    ISFILTERED ( Shp_Dim_SalesRep_Hierarchy[Employee Name Sales Reps] ), ",
              "    VAR ___f = FILTERS ( Shp_Dim_SalesRep_Hierarchy[Employee Name Sales Reps] ) ",
              "    VAR ___r = COUNTROWS ( ___f ) ",
              "    VAR ___t = TOPN ( MaxFilters, ___f, Shp_Dim_SalesRep_Hierarchy[Employee Name Sales Reps]  )",
              "    VAR ___d = CONCATENATEX ( ___t, Shp_Dim_SalesRep_Hierarchy[Employee Name Sales Reps] , \", \" )",
              "    VAR ___x = \"Sales Rep = \" & ___d & IF(___r > MaxFilters, \", ... [\" & ___r & \" items selected]\") & \" \" ",
              "    RETURN ___x & UNICHAR(13) & \"// \"",
              ")"
            ],
            "lineageTag": "875aded0-8b8f-4f35-97fe-a07811b088b8"
          },
          {
            "name": "List_Filter_2",
            "description": "Measure to handle blank values of List Filter ",
            "expression": "IF(ISBLANK([List_Filter]),\" \",[List_Filter]) ",
            "lineageTag": "41485dbe-b634-4287-a217-63ee711bd420"
          },
          {
            "name": "Nr Cust",
            "expression": "DISTINCTCOUNTNOBLANK(Dim_Cust[Customer Combined])",
            "formatString": "0",
            "lineageTag": "bd6371ce-90d5-4d03-97cc-c9a87efdc869"
          },
          {
            "name": "DNA Sales",
            "description": "Total net sales (EUR) for DNA products only.",
            "expression": [
              "CALCULATE (",
              "    SUM ( DATA[Net Sales Actual (EUR)] ),",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "formatString": "\"€\"\\ #,0;-\"€\"\\ #,0;\"€\"\\ #,0",
            "displayFolder": "3.A DNA Solution Overview\\Base",
            "lineageTag": "97328fda-7778-4c4b-bf9e-49b548ca8510"
          },
          {
            "name": "DNA Units",
            "description": "Total units sold for DNA products only.",
            "expression": [
              "CALCULATE (",
              "    SUM ( DATA[Net Sales Qty Actual] ),",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Base",
            "lineageTag": "aa0328d0-1b97-488a-972e-84dbfc6d8cdc"
          },
          {
            "name": "DNA ASP",
            "description": "Average selling price across all DNA products.",
            "expression": "DIVIDE ( [DNA Sales], [DNA Units], BLANK () )",
            "formatString": "\"€\"\\ #,0.00;-\"€\"\\ #,0.00;\"€\"\\ #,0.00",
            "displayFolder": "3.A DNA Solution Overview\\Base",
            "lineageTag": "0667288d-eb66-4204-8bb5-ba7e1a52ccae"
          },
          {
            "name": "DNA Nr Customers",
            "description": "Distinct customers who purchased any DNA product.",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Base",
            "lineageTag": "6793d516-499b-45f8-8f17-3928c985f35a"
          },
          {
            "name": "DNA Product Sales CY",
            "description": "Current FY sales for DNA products. Inherits €/LC and YTD toggles.",
            "expression": [
              "CALCULATE (",
              "    [FY Sales CY],",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "c7ab8fbd-ae32-4e8b-86ad-d58e37d6d1b4"
          },
          {
            "name": "DNA Product Units CY",
            "description": "Current FY units for DNA products.",
            "expression": [
              "CALCULATE (",
              "    [FY Units CY],",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "3e36b344-cd9d-4eff-b11a-dbb84950acad"
          },
          {
            "name": "DNA Product ASP CY",
            "description": "Current FY ASP for DNA products.",
            "expression": "DIVIDE ( [DNA Product Sales CY], [DNA Product Units CY], BLANK () )",
            "formatString": "#,##0.00",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "fc895fa9-7dbb-44f8-ad46-be79474a9f4a"
          },
          {
            "name": "DNA Product ASP Achievement %",
            "description": "ASP achievement vs plan for DNA products.",
            "expression": [
              "VAR _aspPlan =",
              "    CALCULATE (",
              "        [FY ASP Plan],",
              "        Dim_Product[IsDNAProduct] = TRUE",
              "    )",
              "RETURN",
              "DIVIDE ( [DNA Product ASP CY], _aspPlan, BLANK () )"
            ],
            "formatString": "0.00",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "f18cedad-3950-49df-a039-bc6efe8a967a"
          },
          {
            "name": "DNA Product Sales LY",
            "description": "Last FY sales for DNA products.",
            "expression": [
              "CALCULATE (",
              "    [FY Sales LY],",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "4f673ed3-d286-4131-a7a2-43c4e662772e"
          },
          {
            "name": "DNA Product Units LY",
            "description": "Last FY units for DNA products.",
            "expression": [
              "CALCULATE (",
              "    [FY Units LY],",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "d2d5b29e-3eb9-48c4-a2db-028524dbef0f"
          },
          {
            "name": "DNA Product Nr Customers",
            "description": "Distinct customers per DNA product family (place ProductFamily on axis).",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "2283fddb-6df6-468d-bb43-b4a34a7f0848"
          },
          {
            "name": "DNA Product Nr Customers FY",
            "description": "Nr customers — current fiscal year (for FY bar in Product Penetration chart).",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    Dim_Product[IsDNAProduct] = TRUE,",
              "    Dim_Cal[IsFiscCY] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "88dae998-4725-4eb0-8745-345346af5074"
          },
          {
            "name": "DNA Product Nr Customers LY",
            "description": "Nr customers — last fiscal year (for LY bar in Product Penetration chart). NOTE: Uses = 1 because IsFiscLY is int64.",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    Dim_Product[IsDNAProduct] = TRUE,",
              "    Dim_Cal[IsFiscLY] = 1",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Per Product",
            "lineageTag": "8e3b38a1-8983-420f-a34e-874a8085b921"
          },
          {
            "name": "DNA Customers Bought This Year",
            "description": "Distinct DNA customers in current fiscal year.",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    Dim_Product[IsDNAProduct] = TRUE,",
              "    Dim_Cal[IsFiscCY] = TRUE",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "3.A DNA Solution Overview\\Customer Parameters",
            "lineageTag": "fbe010e9-71ac-4517-8437-98a7be287441"
          },
          {
            "name": "DNA New Customers",
            "description": "Customers who bought DNA products this FY but NOT last FY.",
            "expression": [
              "VAR _customersCY =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        Dim_Product[IsDNAProduct] = TRUE,",
              "        Dim_Cal[IsFiscCY] = TRUE",
              "    )",
              "VAR _customersPY =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        Dim_Product[IsDNAProduct] = TRUE,",
              "        Dim_Cal[IsFiscLY] = 1",
              "    )",
              "RETURN",
              "COUNTROWS ( EXCEPT ( _customersCY, _customersPY ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Customer Parameters",
            "lineageTag": "f4bde07a-a988-4a83-a24f-f85ae307a277"
          },
          {
            "name": "DNA Lost Customers",
            "description": "Customers who bought DNA products last FY but NOT this FY.",
            "expression": [
              "VAR _customersCY =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        Dim_Product[IsDNAProduct] = TRUE,",
              "        Dim_Cal[IsFiscCY] = TRUE",
              "    )",
              "VAR _customersPY =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        Dim_Product[IsDNAProduct] = TRUE,",
              "        Dim_Cal[IsFiscLY] = 1",
              "    )",
              "RETURN",
              "COUNTROWS ( EXCEPT ( _customersPY, _customersCY ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Customer Parameters",
            "lineageTag": "8271af61-c0f5-4b4d-95b0-8662a5eb77cf"
          },
          {
            "name": "DNA Retained Customers",
            "description": "Customers who bought DNA products in BOTH current and last FY.",
            "expression": [
              "VAR _customersCY =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        Dim_Product[IsDNAProduct] = TRUE,",
              "        Dim_Cal[IsFiscCY] = TRUE",
              "    )",
              "VAR _customersPY =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        Dim_Product[IsDNAProduct] = TRUE,",
              "        Dim_Cal[IsFiscLY] = 1",
              "    )",
              "RETURN",
              "COUNTROWS ( INTERSECT ( _customersCY, _customersPY ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Customer Parameters",
            "lineageTag": "c35ec80e-4c2d-40f5-bda5-f0eead9e85bb"
          },
          {
            "name": "Customer DNA Category",
            "description": "Classifies the current customer context by which D/N/A families they purchased. Use with SELECTEDVALUE on DNA_Category table.",
            "expression": [
              "VAR _hasD =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"Destination\"",
              "    ) > 0",
              "VAR _hasN =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"NaviCross\"",
              "    ) > 0",
              "VAR _hasA =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"Glidewire Advantage Family\"",
              "    ) > 0",
              "RETURN",
              "SWITCH (",
              "    TRUE (),",
              "    _hasD && _hasN && _hasA, \"DNA\",",
              "    _hasD && _hasA,          \"DA\",",
              "    _hasD && _hasN,          \"DN\",",
              "    _hasN && _hasA,          \"NA\",",
              "    _hasD,                   \"D only\",",
              "    _hasN,                   \"N only\",",
              "    _hasA,                   \"A only\",",
              "    \"Others\"",
              ")"
            ],
            "displayFolder": "3.A DNA Solution Overview\\Solution Penetration",
            "lineageTag": "7487bc80-8be7-4ce4-b651-addb6a414254"
          },
          {
            "name": "Customers by DNA Category",
            "description": "Counts customers matching the selected DNA_Category. Place DNA_Category[Category] on axis.",
            "expression": [
              "VAR _selectedCat = SELECTEDVALUE ( DNA_Category[Category] )",
              "RETURN",
              "IF (",
              "    NOT ISBLANK ( _selectedCat ),",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( DATA[Customer] ),",
              "        FILTER (",
              "            VALUES ( DATA[Customer] ),",
              "            [Customer DNA Category] = _selectedCat",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\Solution Penetration",
            "lineageTag": "c70c5f55-4e8d-47fe-80c5-57eabd8311eb"
          },
          {
            "name": "% Solution Penetration",
            "description": "Share of DNA-classified customers out of all customers buying at least one DNA product.",
            "expression": [
              "VAR _dnaCustomers =",
              "    CALCULATE (",
              "        [Customers by DNA Category],",
              "        DNA_Category[Category] = \"DNA\"",
              "    )",
              "VAR _totalRelevantCustomers =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( DATA[Customer] ),",
              "        Dim_Product[IsDNAProduct] = TRUE",
              "    )",
              "RETURN",
              "DIVIDE ( _dnaCustomers, _totalRelevantCustomers, BLANK () )"
            ],
            "formatString": "0.00%",
            "displayFolder": "3.A DNA Solution Overview\\Solution Penetration",
            "lineageTag": "6e1f7303-454d-4a88-8e4e-e8a9882e30d1"
          },
          {
            "name": "GWA Track Nr Customers",
            "description": "Distinct customers who bought GWA Track SKUs specifically.",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    Dim_Product[IsGWATrack] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\GWA Track",
            "lineageTag": "8e8f2e4f-7d60-4369-90b8-12b209513deb"
          },
          {
            "name": "GWA Including Track Nr Customers",
            "description": "Distinct customers across all Glidewire Advantage SKUs including Track.",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    Dim_Product[ProductFamily] = \"Glidewire Advantage\"",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\GWA Track",
            "lineageTag": "7e9d8115-209e-4b1a-88c5-0a4ed3e11b14"
          },
          {
            "name": "GWA Track Sales CY",
            "description": "Current FY sales for GWA Track SKUs only.",
            "expression": [
              "CALCULATE (",
              "    [FY Sales CY],",
              "    Dim_Product[IsGWATrack] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\GWA Track",
            "lineageTag": "1998eb95-fd27-4400-b578-fc58c7362d40"
          },
          {
            "name": "GWA Track Units CY",
            "description": "Current FY units for GWA Track SKUs only.",
            "expression": [
              "CALCULATE (",
              "    [FY Units CY],",
              "    Dim_Product[IsGWATrack] = TRUE",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.A DNA Solution Overview\\GWA Track",
            "lineageTag": "f0fc8348-b9dd-4af8-b705-0e233bd7aaae"
          },
          {
            "name": "Product Nr Customers FY",
            "description": "Distinct customers for any product in current FY. Place Product Group Text on axis.",
            "expression": "CALCULATE ( DISTINCTCOUNT ( DATA[Customer] ), Dim_Cal[IsFiscCY] = TRUE )",
            "formatString": "#,##0",
            "displayFolder": "3.B Wider Product Analysis\\KPIs",
            "lineageTag": "d35bf8af-3e2b-4539-9da2-03aa4f53f462"
          },
          {
            "name": "Product Nr Customers LY",
            "description": "Distinct customers for any product in last FY.",
            "expression": "CALCULATE ( DISTINCTCOUNT ( DATA[Customer] ), Dim_Cal[IsFiscLY] = 1 )",
            "formatString": "#,##0",
            "displayFolder": "3.B Wider Product Analysis\\KPIs",
            "lineageTag": "8d6f7712-44b7-42bd-84be-7eaf9d9a9243"
          },
          {
            "name": "Product New Customers",
            "description": "Customers buying this product FY but not LY. Works with any product on axis.",
            "expression": [
              "VAR _cy = CALCULATETABLE ( VALUES ( DATA[Customer] ), Dim_Cal[IsFiscCY] = TRUE )",
              "VAR _py = CALCULATETABLE ( VALUES ( DATA[Customer] ), Dim_Cal[IsFiscLY] = 1 )",
              "RETURN COUNTROWS ( EXCEPT ( _cy, _py ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.B Wider Product Analysis\\KPIs",
            "lineageTag": "382bf716-f357-40f8-b3a4-ef8946b2d07e"
          },
          {
            "name": "Product Lost Customers",
            "description": "Customers buying this product LY but not FY.",
            "expression": [
              "VAR _cy = CALCULATETABLE ( VALUES ( DATA[Customer] ), Dim_Cal[IsFiscCY] = TRUE )",
              "VAR _py = CALCULATETABLE ( VALUES ( DATA[Customer] ), Dim_Cal[IsFiscLY] = 1 )",
              "RETURN COUNTROWS ( EXCEPT ( _py, _cy ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.B Wider Product Analysis\\KPIs",
            "lineageTag": "5d4e4770-c759-45e7-b53b-87f67036d49c"
          },
          {
            "name": "Nr Product Groups Bought",
            "description": "Number of distinct product groups a customer purchased. Use with Customer on axis.",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( Dim_Product[Product Group Text] ),",
              "    CROSSFILTER ( DATA[Final_Material], Dim_Product[Material], BOTH )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.B Wider Product Analysis\\Cross-Sell",
            "lineageTag": "efb41300-0f9e-4a96-aa5c-0884af7a6462"
          },
          {
            "name": "Anchor Product Customers",
            "description": "Total customers buying the anchor product group (selected in slicer).",
            "expression": [
              "VAR _anchor = SELECTEDVALUE ( Anchor_ProductGroup[Product Group Text] )",
              "RETURN",
              "IF (",
              "    NOT ISBLANK ( _anchor ),",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Product ),",
              "        Dim_Product[Product Group Text] = _anchor",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.B Wider Product Analysis\\Cross-Sell",
            "lineageTag": "a229945f-03c8-4f22-b269-a198190e26b0"
          },
          {
            "name": "Cross-Sell Overlap Customers",
            "description": "Of customers buying the anchor, how many also buy the axis product group.",
            "expression": [
              "// Select anchor product group in slicer, place Product Group Text on axis",
              "VAR _anchor = SELECTEDVALUE ( Anchor_ProductGroup[Product Group Text] )",
              "VAR _axisProduct = SELECTEDVALUE ( Dim_Product[Product Group Text] )",
              "RETURN",
              "IF (",
              "    NOT ISBLANK ( _anchor ) && NOT ISBLANK ( _axisProduct ),",
              "    VAR _anchorCusts =",
              "        CALCULATETABLE (",
              "            VALUES ( DATA[Customer] ),",
              "            REMOVEFILTERS ( Dim_Product ),",
              "            Dim_Product[Product Group Text] = _anchor",
              "        )",
              "    VAR _axisCusts =",
              "        CALCULATETABLE (",
              "            VALUES ( DATA[Customer] ),",
              "            REMOVEFILTERS ( Dim_Product ),",
              "            Dim_Product[Product Group Text] = _axisProduct",
              "        )",
              "    RETURN",
              "    COUNTROWS ( INTERSECT ( _anchorCusts, _axisCusts ) )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.B Wider Product Analysis\\Cross-Sell",
            "lineageTag": "14a15b89-541a-454c-b9bf-f3d0fdcd1544"
          },
          {
            "name": "Cross-Sell %",
            "description": "% of anchor customers who also buy the axis product group.",
            "expression": "DIVIDE ( [Cross-Sell Overlap Customers], [Anchor Product Customers], BLANK () )",
            "formatString": "0.0%",
            "displayFolder": "3.B Wider Product Analysis\\Cross-Sell",
            "lineageTag": "b68a57c9-0fea-4831-9bef-e4198c82148d"
          },
          {
            "name": "Active Quarter Label",
            "description": "Returns the quarter label based on Fiscal/Calendar toggle.",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "RETURN",
              "IF (",
              "    _qType = 1,",
              "    SELECTEDVALUE ( Dim_Cal[FiscYearQuarter] ),",
              "    SELECTEDVALUE ( Dim_Cal[CalYearQuarter] )",
              ")"
            ],
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "bdf71df1-05ad-49bc-8921-69e1ed780a0c"
          },
          {
            "name": "_QR Current QI",
            "description": "Internal helper: current quarter index based on toggle.",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "RETURN",
              "IF (",
              "    _qType = 1,",
              "    SELECTEDVALUE ( Dim_Cal[FiscQuarterIndex] ),",
              "    SELECTEDVALUE ( Dim_Cal[CalQuarterIndex] )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\_Helpers",
            "lineageTag": "23c404a7-5099-4fea-aff0-10f592427cb1"
          },
          {
            "name": "Q Customers",
            "description": "Distinct customers in the current quarter context.",
            "expression": "DISTINCTCOUNT ( DATA[Customer] )",
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "92fd4c94-134b-4142-a709-7bfb974d16a4"
          },
          {
            "name": "Q New Customers",
            "description": "Customers whose first-ever purchase is in this quarter.",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _currentQI = [_QR Current QI]",
              "VAR _qiCol = IF ( _qType = 1, \"FiscQuarterIndex\", \"CalQuarterIndex\" )",
              "VAR _currentCusts = VALUES ( DATA[Customer] )",
              "VAR _allPriorCusts =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Cal ),",
              "        IF (",
              "            _qType = 1,",
              "            Dim_Cal[FiscQuarterIndex] < _currentQI,",
              "            Dim_Cal[CalQuarterIndex] < _currentQI",
              "        )",
              "    )",
              "RETURN",
              "COUNTROWS ( EXCEPT ( _currentCusts, _allPriorCusts ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "d5c5468a-962f-429c-99e1-ffad164be120"
          },
          {
            "name": "Q Repeat Customers",
            "description": "Customers who bought this quarter AND at least one prior quarter.",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _currentQI = [_QR Current QI]",
              "VAR _currentCusts = VALUES ( DATA[Customer] )",
              "VAR _allPriorCusts =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Cal ),",
              "        IF (",
              "            _qType = 1,",
              "            Dim_Cal[FiscQuarterIndex] < _currentQI,",
              "            Dim_Cal[CalQuarterIndex] < _currentQI",
              "        )",
              "    )",
              "RETURN",
              "COUNTROWS ( INTERSECT ( _currentCusts, _allPriorCusts ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "add3b442-b0e4-4b21-a872-34a4ba384549"
          },
          {
            "name": "Q Lapsed Returning Customers",
            "description": "Bought this Q, skipped last Q, but bought in some earlier Q (win-back).",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _currentQI = [_QR Current QI]",
              "VAR _currentCusts = VALUES ( DATA[Customer] )",
              "// Customers in the immediately prior quarter",
              "VAR _priorQCusts =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Cal ),",
              "        IF (",
              "            _qType = 1,",
              "            Dim_Cal[FiscQuarterIndex] = _currentQI - 1,",
              "            Dim_Cal[CalQuarterIndex] = _currentQI - 1",
              "        )",
              "    )",
              "// Customers in any quarter before the prior quarter",
              "VAR _olderCusts =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Cal ),",
              "        IF (",
              "            _qType = 1,",
              "            Dim_Cal[FiscQuarterIndex] < _currentQI - 1,",
              "            Dim_Cal[CalQuarterIndex] < _currentQI - 1",
              "        )",
              "    )",
              "// Current customers who were NOT in prior Q but WERE in an older Q",
              "VAR _notInPrior = EXCEPT ( _currentCusts, _priorQCusts )",
              "RETURN",
              "COUNTROWS ( INTERSECT ( _notInPrior, _olderCusts ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "e488936f-6e34-4607-9cd5-bfa89e88ed79"
          },
          {
            "name": "Q Consecutive 2+",
            "description": "Customers who bought in both this quarter and the immediately prior quarter.",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _currentQI = [_QR Current QI]",
              "VAR _currentCusts = VALUES ( DATA[Customer] )",
              "VAR _priorQCusts =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Cal ),",
              "        IF (",
              "            _qType = 1,",
              "            Dim_Cal[FiscQuarterIndex] = _currentQI - 1,",
              "            Dim_Cal[CalQuarterIndex] = _currentQI - 1",
              "        )",
              "    )",
              "RETURN",
              "COUNTROWS ( INTERSECT ( _currentCusts, _priorQCusts ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "5622252e-9f38-4f0e-bf5e-d488b38040bd"
          },
          {
            "name": "Q Consecutive 3+",
            "description": "Customers who bought in this quarter AND the two prior quarters (3-quarter streak).",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _currentQI = [_QR Current QI]",
              "VAR _currentCusts = VALUES ( DATA[Customer] )",
              "VAR _q1Custs =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Cal ),",
              "        IF ( _qType = 1, Dim_Cal[FiscQuarterIndex] = _currentQI - 1, Dim_Cal[CalQuarterIndex] = _currentQI - 1 )",
              "    )",
              "VAR _q2Custs =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Cal ),",
              "        IF ( _qType = 1, Dim_Cal[FiscQuarterIndex] = _currentQI - 2, Dim_Cal[CalQuarterIndex] = _currentQI - 2 )",
              "    )",
              "RETURN",
              "COUNTROWS ( INTERSECT ( INTERSECT ( _currentCusts, _q1Custs ), _q2Custs ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "d1e30844-0b1f-49f3-87a8-1d3ea426c5bc"
          },
          {
            "name": "Q Consecutive 4+",
            "description": "Customers with a 4-quarter consecutive buying streak (full year).",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _currentQI = [_QR Current QI]",
              "VAR _currentCusts = VALUES ( DATA[Customer] )",
              "VAR _q1 = CALCULATETABLE ( VALUES ( DATA[Customer] ), REMOVEFILTERS ( Dim_Cal ),",
              "    IF ( _qType = 1, Dim_Cal[FiscQuarterIndex] = _currentQI - 1, Dim_Cal[CalQuarterIndex] = _currentQI - 1 ) )",
              "VAR _q2 = CALCULATETABLE ( VALUES ( DATA[Customer] ), REMOVEFILTERS ( Dim_Cal ),",
              "    IF ( _qType = 1, Dim_Cal[FiscQuarterIndex] = _currentQI - 2, Dim_Cal[CalQuarterIndex] = _currentQI - 2 ) )",
              "VAR _q3 = CALCULATETABLE ( VALUES ( DATA[Customer] ), REMOVEFILTERS ( Dim_Cal ),",
              "    IF ( _qType = 1, Dim_Cal[FiscQuarterIndex] = _currentQI - 3, Dim_Cal[CalQuarterIndex] = _currentQI - 3 ) )",
              "RETURN",
              "COUNTROWS ( INTERSECT ( INTERSECT ( INTERSECT ( _currentCusts, _q1 ), _q2 ), _q3 ) )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "4bd9affd-5c6c-4993-a473-42408839a37d"
          },
          {
            "name": "Q Retention Rate %",
            "description": "% of prior-quarter customers who came back this quarter.",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _currentQI = [_QR Current QI]",
              "VAR _currentCusts = VALUES ( DATA[Customer] )",
              "VAR _priorQCusts =",
              "    CALCULATETABLE (",
              "        VALUES ( DATA[Customer] ),",
              "        REMOVEFILTERS ( Dim_Cal ),",
              "        IF (",
              "            _qType = 1,",
              "            Dim_Cal[FiscQuarterIndex] = _currentQI - 1,",
              "            Dim_Cal[CalQuarterIndex] = _currentQI - 1",
              "        )",
              "    )",
              "VAR _retained = COUNTROWS ( INTERSECT ( _currentCusts, _priorQCusts ) )",
              "VAR _priorTotal = COUNTROWS ( _priorQCusts )",
              "RETURN",
              "DIVIDE ( _retained, _priorTotal, BLANK () )"
            ],
            "formatString": "0.0%",
            "displayFolder": "3.C Quarterly Retention",
            "lineageTag": "f020736c-5ef2-4775-a09b-88f4ebcb026f"
          },
          {
            "name": "_QR Max QI in Scope",
            "description": "Helper: highest quarter index in the current filter context.",
            "expression": [
              "",
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "RETURN",
              "CALCULATE (",
              "    IF (",
              "        _qType = 1,",
              "        MAXX ( DATA, RELATED ( Dim_Cal[FiscQuarterIndex] ) ),",
              "        MAXX ( DATA, RELATED ( Dim_Cal[CalQuarterIndex] ) )",
              "    ),",
              "    REMOVEFILTERS ( Dim_Cust ),",
              "    REMOVEFILTERS ( Dim_Product )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "20332050-c3e4-4852-9cdd-cbc3265b7326"
          },
          {
            "name": "Customer Streak",
            "description": "Number of consecutive quarters the customer has been buying, counting back from the latest quarter in scope. Max 8. Place Customer on rows.",
            "expression": [
              "",
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _maxQI =",
              "    CALCULATE (",
              "        IF (",
              "            _qType = 1,",
              "            MAXX ( DATA, RELATED ( Dim_Cal[FiscQuarterIndex] ) ),",
              "            MAXX ( DATA, RELATED ( Dim_Cal[CalQuarterIndex] ) )",
              "        ),",
              "        REMOVEFILTERS ( Dim_Cust ),",
              "        REMOVEFILTERS ( Dim_Product )",
              "    )",
              "VAR _q0 =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[FiscQuarterIndex] = _maxQI ),",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[CalQuarterIndex] = _maxQI )",
              "    ) > 0",
              "VAR _q1 =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[FiscQuarterIndex] = _maxQI - 1 ),",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[CalQuarterIndex] = _maxQI - 1 )",
              "    ) > 0",
              "VAR _q2 =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[FiscQuarterIndex] = _maxQI - 2 ),",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[CalQuarterIndex] = _maxQI - 2 )",
              "    ) > 0",
              "VAR _q3 =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[FiscQuarterIndex] = _maxQI - 3 ),",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[CalQuarterIndex] = _maxQI - 3 )",
              "    ) > 0",
              "VAR _q4 =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[FiscQuarterIndex] = _maxQI - 4 ),",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[CalQuarterIndex] = _maxQI - 4 )",
              "    ) > 0",
              "VAR _q5 =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[FiscQuarterIndex] = _maxQI - 5 ),",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[CalQuarterIndex] = _maxQI - 5 )",
              "    ) > 0",
              "VAR _q6 =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[FiscQuarterIndex] = _maxQI - 6 ),",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[CalQuarterIndex] = _maxQI - 6 )",
              "    ) > 0",
              "VAR _q7 =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[FiscQuarterIndex] = _maxQI - 7 ),",
              "        CALCULATE ( COUNTROWS ( DATA ), REMOVEFILTERS ( Dim_Cal ), Dim_Cal[CalQuarterIndex] = _maxQI - 7 )",
              "    ) > 0",
              "RETURN",
              "IF (",
              "    NOT _q0, 0,",
              "    IF ( NOT _q1, 1,",
              "    IF ( NOT _q2, 2,",
              "    IF ( NOT _q3, 3,",
              "    IF ( NOT _q4, 4,",
              "    IF ( NOT _q5, 5,",
              "    IF ( NOT _q6, 6,",
              "    IF ( NOT _q7, 7, 8",
              "    ) ) ) ) ) ) )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "724a9e29-686c-4cde-8e8c-8b1e3be5483e"
          },
          {
            "name": "Customer Status",
            "description": "Six-tier customer classification: Loyal (4+ Qs), Active (2-3 Qs), Returning (came back after gap), New (first purchase), Lapsed (recently dropped), Inactive (gone 2+ Qs).",
            "expression": [
              "",
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _maxQI =",
              "    CALCULATE (",
              "        IF (",
              "            _qType = 1,",
              "            MAXX ( DATA, RELATED ( Dim_Cal[FiscQuarterIndex] ) ),",
              "            MAXX ( DATA, RELATED ( Dim_Cal[CalQuarterIndex] ) )",
              "        ),",
              "        REMOVEFILTERS ( Dim_Cust ),",
              "        REMOVEFILTERS ( Dim_Product )",
              "    )",
              "VAR _streak = [Customer Streak]",
              "VAR _boughtLatest = _streak > 0",
              "VAR _allPriorCusts =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE (",
              "            COUNTROWS ( DATA ),",
              "            REMOVEFILTERS ( Dim_Cal ),",
              "            Dim_Cal[FiscQuarterIndex] < _maxQI",
              "        ),",
              "        CALCULATE (",
              "            COUNTROWS ( DATA ),",
              "            REMOVEFILTERS ( Dim_Cal ),",
              "            Dim_Cal[CalQuarterIndex] < _maxQI",
              "        )",
              "    )",
              "VAR _hasPriorHistory = _allPriorCusts > 0",
              "VAR _boughtPriorQ =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE (",
              "            COUNTROWS ( DATA ),",
              "            REMOVEFILTERS ( Dim_Cal ),",
              "            Dim_Cal[FiscQuarterIndex] = _maxQI - 1",
              "        ),",
              "        CALCULATE (",
              "            COUNTROWS ( DATA ),",
              "            REMOVEFILTERS ( Dim_Cal ),",
              "            Dim_Cal[CalQuarterIndex] = _maxQI - 1",
              "        )",
              "    ) > 0",
              "RETURN",
              "SWITCH (",
              "    TRUE (),",
              "    _boughtLatest && _streak >= 4,          \"Loyal\",",
              "    _boughtLatest && _streak >= 2,          \"Active\",",
              "    _boughtLatest && NOT _hasPriorHistory,   \"New\",",
              "    _boughtLatest && _hasPriorHistory,       \"Returning\",",
              "    NOT _boughtLatest && _boughtPriorQ,      \"Lapsed\",",
              "    NOT _boughtLatest && NOT _boughtPriorQ,  \"Inactive\",",
              "    \"Unknown\"",
              ")"
            ],
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "da5d45b0-43bc-42dc-b5b2-5f6e30067c19"
          },
          {
            "name": "Customer Status Sort",
            "description": "Sort order for Customer Status. Use as Sort By in visuals: Loyal=1 (best) to Inactive=6 (worst).",
            "expression": [
              "SWITCH (",
              "    [Customer Status],",
              "    \"Loyal\",     1,",
              "    \"Active\",    2,",
              "    \"Returning\", 3,",
              "    \"New\",       4,",
              "    \"Lapsed\",    5,",
              "    \"Inactive\",  6,",
              "    99",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "5f21198c-f97c-4cb7-9621-6db66fa9cde4"
          },
          {
            "name": "Count Loyal Customers",
            "description": "Total customers classified as Loyal (4+ consecutive quarters).",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    FILTER (",
              "        VALUES ( DATA[Customer] ),",
              "        [Customer Status] = \"Loyal\"",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "941fbb52-0d87-4094-a744-418265766ada"
          },
          {
            "name": "Count Active Customers",
            "description": "Total customers classified as Active (2-3 consecutive quarters).",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    FILTER (",
              "        VALUES ( DATA[Customer] ),",
              "        [Customer Status] = \"Active\"",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "60c6f9cd-7c4d-432d-946b-136c81c19737"
          },
          {
            "name": "Count Returning Customers",
            "description": "Total customers classified as Returning (came back after a gap).",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    FILTER (",
              "        VALUES ( DATA[Customer] ),",
              "        [Customer Status] = \"Returning\"",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "b9915d78-f172-4d2f-ab61-c0c075ad8f8c"
          },
          {
            "name": "Count New Customers (Status)",
            "description": "Total customers classified as New (first-ever purchase in latest quarter).",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    FILTER (",
              "        VALUES ( DATA[Customer] ),",
              "        [Customer Status] = \"New\"",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "407742e5-2492-4dc0-a0a1-5f2dac247c3a"
          },
          {
            "name": "Count Lapsed Customers",
            "description": "Total customers classified as Lapsed (bought Q-1 but not latest Q).",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    FILTER (",
              "        VALUES ( DATA[Customer] ),",
              "        [Customer Status] = \"Lapsed\"",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "1246f16e-6cdf-45a5-8039-a51f23a18208"
          },
          {
            "name": "Count Inactive Customers",
            "description": "Total customers classified as Inactive (no purchase in last 2+ quarters).",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( DATA[Customer] ),",
              "    FILTER (",
              "        VALUES ( DATA[Customer] ),",
              "        [Customer Status] = \"Inactive\"",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "cc37157b-d37a-4fe8-823f-a97706807c61"
          },
          {
            "name": "Q Customer Sales",
            "description": "Sales per customer per quarter. Returns BLANK for quarters with no purchase (shows as — in the matrix).",
            "expression": [
              "VAR _sales = [FY Sales CY]",
              "RETURN",
              "IF ( _sales <> 0, _sales, BLANK () )"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "7138338d-a5a1-463f-87f9-5f1b8524f531"
          },
          {
            "name": "Customer Last Purchase Quarter",
            "description": "Most recent quarter label in which the customer made a purchase. Useful for tooltips.",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "RETURN",
              "IF (",
              "    _qType = 1,",
              "    CALCULATE (",
              "        MAX ( Dim_Cal[FiscYearQuarter] ),",
              "        DATA",
              "    ),",
              "    CALCULATE (",
              "        MAX ( Dim_Cal[CalYearQuarter] ),",
              "        DATA",
              "    )",
              ")"
            ],
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "a4742314-2a0d-4be1-b0a8-f110d22cb682"
          },
          {
            "name": "Quarters Since Last Purchase",
            "description": "How many quarters since this customer last purchased. 0 = bought this quarter, 1 = last quarter, etc. Use for at-risk flagging.",
            "expression": [
              "VAR _qType = SELECTEDVALUE ( Button_QuarterType[ID], 1 )",
              "VAR _maxQI = [_QR Max QI in Scope]",
              "VAR _lastPurchaseQI =",
              "    IF (",
              "        _qType = 1,",
              "        CALCULATE ( MAX ( Dim_Cal[FiscQuarterIndex] ), DATA ),",
              "        CALCULATE ( MAX ( Dim_Cal[CalQuarterIndex] ), DATA )",
              "    )",
              "RETURN",
              "IF (",
              "    NOT ISBLANK ( _lastPurchaseQI ),",
              "    _maxQI - _lastPurchaseQI,",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "5aa9c198-42be-482c-beba-69ce117e51df"
          },
          {
            "name": "Loyal Customers full Year",
            "expression": "DIVIDE([Q Consecutive 4+],[Q Customers],0)",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "3.C Quarterly Retention\\Customer Status",
            "lineageTag": "2f167c59-c85f-4ed2-bdb0-e5efce505b5a"
          },
          {
            "name": "Customer DNA Category LY",
            "expression": [
              "",
              "VAR _hasA =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"Glidewire Advantage Family\",",
              "        Dim_Cal[IsFiscLY] = 1",
              "    ) > 0",
              "VAR _hasN =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"NaviCross\",",
              "        Dim_Cal[IsFiscLY] = 1",
              "    ) > 0",
              "VAR _hasD =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"Destination\",",
              "        Dim_Cal[IsFiscLY] = 1",
              "    ) > 0",
              "RETURN",
              "SWITCH (",
              "    TRUE (),",
              "    _hasD && _hasN && _hasA, \"DNA\",",
              "    _hasD && _hasA,          \"DA\",",
              "    _hasD && _hasN,          \"DN\",",
              "    _hasN && _hasA,          \"NA\",",
              "    _hasD,                   \"D only\",",
              "    _hasN,                   \"N only\",",
              "    _hasA,                   \"A only\",",
              "    \"Others\"",
              ")"
            ],
            "displayFolder": "3.A DNA Solution Overview\\Solution Penetration",
            "lineageTag": "1e146caf-2acd-48c1-be82-9e0765a70561"
          },
          {
            "name": "Customer DNA Category FY",
            "expression": [
              "",
              "VAR _hasA =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"Glidewire Advantage Family\",",
              "        Dim_Cal[IsFiscCY] = TRUE",
              "    ) > 0",
              "VAR _hasN =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"NaviCross\",",
              "        Dim_Cal[IsFiscCY] = TRUE",
              "    ) > 0",
              "VAR _hasD =",
              "    CALCULATE (",
              "        COUNTROWS ( DATA ),",
              "        Dim_Product[ProductFamily] = \"Destination\",",
              "        Dim_Cal[IsFiscCY] = TRUE",
              "    ) > 0",
              "RETURN",
              "SWITCH (",
              "    TRUE (),",
              "    _hasD && _hasN && _hasA, \"DNA\",",
              "    _hasD && _hasA,          \"DA\",",
              "    _hasD && _hasN,          \"DN\",",
              "    _hasN && _hasA,          \"NA\",",
              "    _hasD,                   \"D only\",",
              "    _hasN,                   \"N only\",",
              "    _hasA,                   \"A only\",",
              "    \"Others\"",
              ")"
            ],
            "displayFolder": "3.A DNA Solution Overview\\Solution Penetration",
            "lineageTag": "5576f728-0f6a-4162-b495-bbd33a258bb7"
          },
          {
            "name": "Customers by DNA Category FY",
            "expression": [
              "",
              "VAR _selectedCat = SELECTEDVALUE ( DNA_Category[Category] )",
              "RETURN",
              "IF (",
              "    NOT ISBLANK ( _selectedCat ),",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( DATA[Customer] ),",
              "        FILTER (",
              "            VALUES ( DATA[Customer] ),",
              "            [Customer DNA Category FY] = _selectedCat",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "3.A DNA Solution Overview\\Solution Penetration",
            "lineageTag": "f3a35048-bd8d-4985-987b-fd7ba89bf959"
          },
          {
            "name": "Customers by DNA Category LY",
            "expression": [
              "",
              "VAR _selectedCat = SELECTEDVALUE ( DNA_Category[Category] )",
              "RETURN",
              "IF (",
              "    NOT ISBLANK ( _selectedCat ),",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( DATA[Customer] ),",
              "        FILTER (",
              "            VALUES ( DATA[Customer] ),",
              "            [Customer DNA Category LY] = _selectedCat",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "3.A DNA Solution Overview\\Solution Penetration",
            "lineageTag": "1d39497c-39cf-40c8-92e5-15062d665cd3"
          },
          {
            "name": "DNA FY Sales CY",
            "description": "DNA Sales for Current Fiscal Year - Respects EUR/LC and YTD/Full Year buttons",
            "expression": [
              "CALCULATE(",
              "    SWITCH(",
              "        TRUE(),",
              "        AND(MIN('Button €/LC'[ID])=1, MIN('Button FiscalYTD'[ID])=2), ",
              "            SUM('DATA'[Net Sales Actual (EUR)]),",
              "        AND(MIN('Button €/LC'[ID])=2, MIN('Button FiscalYTD'[ID])=2), ",
              "            SUM('DATA'[Net Sales Actual (LC)]),",
              "        AND(MIN('Button €/LC'[ID])=1, MIN('Button FiscalYTD'[ID])=1), ",
              "            SUM('DATA'[Net Sales Actual (EUR)]),",
              "        AND(MIN('Button €/LC'[ID])=2, MIN('Button FiscalYTD'[ID])=1), ",
              "            SUM('DATA'[Net Sales Actual (LC)])",
              "    ) / Scalling[SelectedScaling],",
              "    VALUES('Dim_Cal'[IsFiscYTD]),",
              "    VALUES('Dim_Cal'[IsFiscCY]),",
              "    Dim_Cal[IsFiscYTD]=TRUE && Dim_Cal[IsFiscCY]=TRUE,",
              "    Dim_Product[IsDNAProduct] = TRUE",
              ")"
            ],
            "displayFolder": "DNA Metrics",
            "lineageTag": "477e58fc-2e5d-48f6-ac0f-69f8d7aa121f"
          },
          {
            "name": "DNA FY Units CY",
            "description": "DNA Units for Current Fiscal Year",
            "expression": [
              "VAR _ytd = SELECTEDVALUE('Button FiscalYTD'[ID], 2)",
              "RETURN",
              "IF(",
              "    _ytd = 1,",
              "    CALCULATE(",
              "        SUM('DATA'[Net Sales Qty Actual]),",
              "        FILTER(VALUES('Dim_Cal'[IsFiscCY]),  Dim_Cal[IsFiscCY]  = TRUE),",
              "        FILTER(VALUES('Dim_Cal'[IsFiscYTD]), Dim_Cal[IsFiscYTD] = TRUE),",
              "        Dim_Product[IsDNAProduct] = TRUE",
              "    ),",
              "    CALCULATE(",
              "        SUM('DATA'[Net Sales Qty Actual]),",
              "        FILTER(VALUES('Dim_Cal'[IsFiscCY]), Dim_Cal[IsFiscCY] = TRUE),",
              "        Dim_Product[IsDNAProduct] = TRUE",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "DNA Metrics",
            "lineageTag": "7769a2cc-6546-49aa-8227-34e6b1f966a0"
          },
          {
            "name": "DNA FY ASP CY",
            "description": "DNA Average Selling Price for Current Fiscal Year",
            "expression": "DIVIDE([DNA FY Sales CY], [DNA FY Units CY], BLANK())",
            "displayFolder": "DNA Metrics",
            "lineageTag": "662f75b3-d0b8-48b5-ab4d-5564b5bb3bb0"
          },
          {
            "name": "DNA FY Sales LY",
            "description": "DNA Sales for Last Fiscal Year",
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    AND(MIN('Button €/LC'[ID])=1, MIN('Button FiscalYTD'[ID])=2),",
              "        CALCULATE(",
              "            SUM('DATA'[Net Sales Actual (EUR)])/Scalling[SelectedScaling],",
              "            FILTER(VALUES('Dim_Cal'[IsFiscLY]), Dim_Cal[IsFiscLY]=1),",
              "            Dim_Product[IsDNAProduct] = TRUE",
              "        ),",
              "    AND(MIN('Button €/LC'[ID])=2, MIN('Button FiscalYTD'[ID])=2),",
              "        CALCULATE(",
              "            SUM('DATA'[Net Sales Actual (LC)])/Scalling[SelectedScaling],",
              "            FILTER(VALUES('Dim_Cal'[IsFiscLY]), Dim_Cal[IsFiscLY]=1),",
              "            Dim_Product[IsDNAProduct] = TRUE",
              "        ),",
              "    AND(MIN('Button €/LC'[ID])=1, MIN('Button FiscalYTD'[ID])=1),",
              "        CALCULATE(",
              "            SUM('DATA'[Net Sales Actual (EUR)])/Scalling[SelectedScaling],",
              "            FILTER(VALUES('Dim_Cal'[IsFiscYTD]), Dim_Cal[IsFiscYTD]=TRUE),",
              "            FILTER(VALUES('Dim_Cal'[IsFiscLY]), Dim_Cal[IsFiscLY]=1),",
              "            Dim_Product[IsDNAProduct] = TRUE",
              "        ),",
              "    AND(MIN('Button €/LC'[ID])=2, MIN('Button FiscalYTD'[ID])=1),",
              "        CALCULATE(",
              "            SUM('DATA'[Net Sales Actual (LC)])/Scalling[SelectedScaling],",
              "            FILTER(VALUES('Dim_Cal'[IsFiscYTD]), Dim_Cal[IsFiscYTD]=TRUE),",
              "            FILTER(VALUES('Dim_Cal'[IsFiscLY]), Dim_Cal[IsFiscLY]=1),",
              "            Dim_Product[IsDNAProduct] = TRUE",
              "        )",
              ")"
            ],
            "displayFolder": "DNA Metrics",
            "lineageTag": "8e298066-5a3d-4542-acbd-689d033404ad"
          },
          {
            "name": "DNA FY Units LY",
            "description": "DNA Units for Last Fiscal Year",
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    AND(MIN('Button €/LC'[ID])=1, MIN('Button FiscalYTD'[ID])=2),",
              "        CALCULATE(",
              "            SUM('DATA'[Net Sales Qty Actual]),",
              "            FILTER(VALUES('Dim_Cal'[IsFiscLY]), Dim_Cal[IsFiscLY]=1),",
              "            Dim_Product[IsDNAProduct] = TRUE",
              "        ),",
              "    AND(MIN('Button €/LC'[ID])=2, MIN('Button FiscalYTD'[ID])=2),",
              "        CALCULATE(",
              "            SUM('DATA'[Net Sales Qty Actual]),",
              "            FILTER(VALUES('Dim_Cal'[IsFiscLY]), Dim_Cal[IsFiscLY]=1),",
              "            Dim_Product[IsDNAProduct] = TRUE",
              "        ),",
              "    AND(MIN('Button €/LC'[ID])=1, MIN('Button FiscalYTD'[ID])=1),",
              "        CALCULATE(",
              "            SUM('DATA'[Net Sales Qty Actual]),",
              "            FILTER(VALUES('Dim_Cal'[IsFiscYTD]), Dim_Cal[IsFiscYTD]=TRUE),",
              "            FILTER(VALUES('Dim_Cal'[IsFiscLY]), Dim_Cal[IsFiscLY]=1),",
              "            Dim_Product[IsDNAProduct] = TRUE",
              "        ),",
              "    AND(MIN('Button €/LC'[ID])=2, MIN('Button FiscalYTD'[ID])=1),",
              "        CALCULATE(",
              "            SUM('DATA'[Net Sales Qty Actual]),",
              "            FILTER(VALUES('Dim_Cal'[IsFiscYTD]), Dim_Cal[IsFiscYTD]=TRUE),",
              "            FILTER(VALUES('Dim_Cal'[IsFiscLY]), Dim_Cal[IsFiscLY]=1),",
              "            Dim_Product[IsDNAProduct] = TRUE",
              "        )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "DNA Metrics",
            "lineageTag": "65620f5d-056b-4415-964d-3cfb1fc9926f"
          },
          {
            "name": "DNA FY ASP LY",
            "description": "DNA Average Selling Price for Last Fiscal Year",
            "expression": "DIVIDE([DNA FY Sales LY], [DNA FY Units LY], BLANK())",
            "displayFolder": "DNA Metrics",
            "lineageTag": "c60e5de5-de94-456b-a59c-425205fc4481"
          },
          {
            "name": "DNA FY Figures CY",
            "description": "DNA metric switcher for KPI cards - Use with Button Figures slicer",
            "expression": [
              "VAR _index = SELECTEDVALUE('Button Figures'[Index], 1)",
              "RETURN",
              "SWITCH(",
              "    _index,",
              "    1, [DNA FY Sales CY],",
              "    2, [DNA FY Units CY],",
              "    3, [DNA FY ASP CY],",
              "    BLANK()",
              ")"
            ],
            "displayFolder": "DNA Metrics",
            "lineageTag": "bd5dbd26-6458-4e8a-b261-e6e240b4974f"
          },
          {
            "name": "DNA FY Figures LY",
            "description": "DNA Last Year comparison for Button Figures",
            "expression": [
              "VAR _index = SELECTEDVALUE('Button Figures'[Index], 1)",
              "RETURN",
              "SWITCH(",
              "    _index,",
              "    1, [DNA FY Sales LY],",
              "    2, [DNA FY Units LY],",
              "    3, [DNA FY ASP LY],",
              "    BLANK()",
              ")"
            ],
            "displayFolder": "DNA Metrics",
            "lineageTag": "2a1875bb-3215-4805-a1e3-fc42f77f907f"
          },
          {
            "name": "DNA FY Figures vsLY",
            "description": "DNA variance vs Last Year (absolute)",
            "expression": "[DNA FY Figures CY] - [DNA FY Figures LY]",
            "displayFolder": "DNA Metrics",
            "lineageTag": "c68c5f16-9610-4004-8f58-749ecfb22b4a"
          },
          {
            "name": "DNA FY Figures vsLY%",
            "description": "DNA variance vs Last Year (%)",
            "expression": [
              "IF(",
              "    ISBLANK([DNA FY Figures LY]),",
              "    BLANK(),",
              "    DIVIDE([DNA FY Figures CY], [DNA FY Figures LY], BLANK()) - 1",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "DNA Metrics",
            "lineageTag": "274634a8-ea45-4b80-b488-0aa4da04a5ae"
          },
          {
            "name": "DNA FY Figures Title",
            "description": "Dynamic title for DNA KPI card based on button selection",
            "expression": [
              "VAR _index = SELECTEDVALUE('Button Figures'[Index], 1)",
              "VAR _metric = SWITCH(",
              "    _index,",
              "    1, \"Sales\",",
              "    2, \"Units\",",
              "    3, \"ASP\",",
              "    \"Metric\"",
              ")",
              "VAR _ytdFlag = SELECTEDVALUE('Button FiscalYTD'[ID], 2)",
              "VAR _period = IF(_ytdFlag = 1, \"YTD\", \"Full Year\")",
              "RETURN",
              "\"DNA \" & _metric & \" - FY \" & _period"
            ],
            "displayFolder": "DNA Metrics",
            "lineageTag": "fd3ac460-725c-49c6-828e-9a580dfff176"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
