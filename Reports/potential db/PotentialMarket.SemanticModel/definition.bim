                "    #\"ed8db2d9-46ed-47a9-a79b-cdd78ab273c6\" = #\"cb3543d9-1b55-42ea-8443-b7363fd1245c\"{[dataflowId=\"ed8db2d9-46ed-47a9-a79b-cdd78ab273c6\"]}[Data],",
                "    Calendar1 = #\"ed8db2d9-46ed-47a9-a79b-cdd78ab273c6\"{[entity=\"Calendar\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(Calendar1,{{\"Year\", \"Calendar Year\"}, {\"YearQuarter\", \"CalendarYearQuarter\"}, {\"FYearMonth\", \"FiscalYearMonth\"}, {\"FYearQuarter\", \"FiscalYearQuarter\"}, {\"Quarter\", \"CalendarQuarter\"}, {\"FQuarter\", \"FiscalQuarter\"}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Renamed Columns\", \"Current Year\", each Date.Year(DateTime.LocalNow())),",
                "    #\"Added Custom1\" = Table.AddColumn(#\"Added Custom\", \"Selection\", each if ([Calendar Year] >= [Current Year] -3) and ([Calendar Year] <= [Current Year] +1) then \"YES\" else \"NO\"),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Added Custom1\", each ([Selection] = \"YES\")),",
                "    #\"Removed Other Columns\" = Table.SelectColumns(#\"Filtered Rows\",{\"Date\", \"Calendar Year\", \"Month\", \"Fiscal Year\", \"Month Name\", \"MMM\", \"Fiscal Month\"}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Removed Other Columns\",{{\"MMM\", \"MMM\"}}),",
                "    #\"Added Custom2\" = Table.AddColumn(#\"Renamed Columns1\", \"IsCurrentMonth\", each Date.IsInCurrentMonth([Date])),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Added Custom2\",{{\"IsCurrentMonth\", type logical}}),",
                "    #\"Inserted FQ\" = Table.AddColumn(#\"Changed Type\", \"Fiscal Quarter Number\", each if Date.QuarterOfYear([Date]) = 1 then 4 else Date.QuarterOfYear([Date]) - 1,Int64.Type),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Inserted FQ\")",
