        ],
        "partitions": [
          {
            "name": "Final Destination",
            "mode": "import",
            "queryGroup": "1. Main Database",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  // =========================",
                "  // Strong normalization & keys",
                "  // =========================",
                "  NormalizeName = (n as text) as text =>",
                "      let",
                "          s0   = if n = null then \"\" else n,",
                "          // common nasty whitespace & separators",
                "          nb   = Character.FromNumber(160),   // NBSP",
                "          zws  = Character.FromNumber(8203),  // zero-width space",
                "          thin = Character.FromNumber(8201),  // thin space",
                "          ensp = Character.FromNumber(8194),  // en space",
                "          emsp = Character.FromNumber(8195),  // em space",
                "          nnbsp= Character.FromNumber(8239),  // narrow NBSP",
                "          bom  = Character.FromNumber(65279), // BOM/ZWNBSP",
                "          ide  = Character.FromNumber(12288), // ideographic space",
                "          s1   = Text.Replace(s0, nb,  \" \"),",
                "          s2   = Text.Replace(s1, zws, \" \"),",
                "          s3   = Text.Replace(s2, thin,\" \"),",
                "          s4   = Text.Replace(s3, ensp,\" \"),",
                "          s5   = Text.Replace(s4, emsp,\" \"),",
                "          s6   = Text.Replace(s5, nnbsp,\" \"),",
                "          s7   = Text.Replace(s6, bom, \" \"),",
                "          s8   = Text.Replace(s7, ide, \" \"),",
                "          s9   = Text.Replace(Text.Replace(Text.Replace(s8, \"#(tab)\", \" \"), \"#(cr)\", \" \"), \"#(lf)\", \" \"),",
                "          s10  = Text.Replace(Text.Replace(s9, \"_\", \" \"), \"-\", \" \"),",
                "          t1   = Text.Trim(s10),",
                "          parts= List.Select(Text.Split(t1, \" \"), each _ <> \"\"),",
                "          t2   = Text.Combine(parts, \" \")",
                "      in  t2,",
                "",
                "  CanonKey = (n as text) as text => Text.Lower(NormalizeName(n)),",
                "",
                "  // Collapse duplicates by normalized key: keep first encounter, drop the rest",
                "  CollapseAllByKey = (tbl as table) as table =>",
                "    let",
                "      cols   = Table.ColumnNames(tbl),",
                "      idxs   = {0..List.Count(cols)-1},",
                "      folded =",
                "        List.Accumulate(",
                "          idxs,",
                "          [keys = {}, t = tbl],",
                "          (state, i) =>",
                "            let",
                "              name = cols{i},",
                "              key  = CanonKey(name),",
                "              seen = List.Contains(state[keys], key),",
                "              t2   = if seen then Table.RemoveColumns(state[t], {name}, MissingField.Ignore) else state[t],",
                "              k2   = if seen then state[keys] else state[keys] & { key }",
                "            in",
                "              [keys = k2, t = t2]",
                "        )",
                "    in",
                "      folded[t],",
                "",
                "  // ORDER-SAFE canonicalization to a fixed contract (allow-list)",
                "  CanonicalizeToContract =",
                "    (tbl as table, contract as list) as table =>",
                "    let",
                "      // first collapse any dup keys to avoid rename conflicts",
                "      base = CollapseAllByKey(tbl),",
                "      step =",
                "        List.Accumulate(",
                "          contract,",
                "          base,",
                "          (state as table, canonical as text) =>",
                "            let",
                "              keyCanon  = CanonKey(canonical),",
                "              cols      = Table.ColumnNames(state),",
                "              matches   = List.Select(cols, each CanonKey(_) = keyCanon),",
                "              state0    = if List.Count(matches)=0",
                "                          then Table.AddColumn(state, canonical, each null)",
                "                          else state,",
                "              cols1     = Table.ColumnNames(state0),",
                "              matches1  = List.Select(cols1, each CanonKey(_) = keyCanon),",
                "              keepCol   = if List.Contains(matches1, canonical) then canonical else matches1{0},",
                "              // 1) drop siblings FIRST",
                "              dropCols  = List.RemoveItems(matches1, { keepCol }),",
                "              state1    = if List.Count(dropCols)>0 then Table.RemoveColumns(state0, dropCols, MissingField.Ignore) else state0,",
                "              // 2) THEN rename keeper if needed",
                "              state2    = if keepCol <> canonical then Table.RenameColumns(state1, {{keepCol, canonical}}, MissingField.Ignore) else state1",
                "            in",
                "              state2",
                "        ),",
                "      projected = Table.SelectColumns(step, contract, MissingField.UseNull)",
                "    in",
                "      projected,",
                "",
                "  // Null-safe text",
                "  T = (x as any) as text => if x = null then \"\" else Text.From(x),",
                "",
                "  // =========================",
                "  // Sources & base transforms",
                "  // =========================",
                "  Source = PowerBI.Dataflows(null),",
                "  WS     = Source{[workspaceId=\"86518ba8-a440-43ac-90f9-40128646ac4a\"]}[Data],",
                "  DF     = WS{[dataflowId=\"e9ab6338-2833-4bfd-a421-2afa92f7a871\"]}[Data],",
                "  GM     = DF{[entity=\"Gross Margin with See-Through\"]}[Data],",
                "",
                "  GM1  = Table.RenameColumns(GM, {{\"See Through Cost\", \"Deemed Cost\"}}, MissingField.Ignore),",
                "",
                "  Filt1 =",
                "    Table.SelectRows(GM1,",
                "      each (Record.HasFields(_, \"Sales Document Type\") and [Sales Document Type] <> \"ZOSM\")",
                "        and (Record.HasFields(_, \"Business Area\")        and [Business Area] <> \"B150\")),",
                "",
                "  Filt2 =",
                "    Table.SelectRows(Filt1,",
                "      each let pc = try Text.From([Profit Center]) otherwise null",
                "           in  pc <> null and Text.StartsWith(pc, \"PC1\")),",
                "",
                "  WithLast3 =",
                "    Table.AddColumn(Filt2, \"Last_3_years\",",
                "      each",
                "        let",
                "          cym   = try Text.From(Record.Field(_, \"Calendar Year/Month\")) otherwise null,",
                "          fy    = try Record.Field(_, \"Fiscal year\") otherwise null,",
                "          fyY   = try (if Value.Is(fy, type number) then Number.From(fy) else Number.From(Text.From(fy))) otherwise null,",
                "          d     = try Record.Field(_, \"Date\") otherwise null,",
                "          dy    = try Date.Year(d) otherwise null,",
                "          cymY  = try Number.From(Text.Start(cym, 4)) otherwise null,",
                "          thisY = Date.Year(DateTime.LocalNow())",
                "        in",
                "          if cymY <> null and fyY <> null and dy <> null then",
                "            if (cymY > fyY and dy >= thisY - 2 and dy <= thisY + 1)",
                "               or (cymY = fyY and dy >= thisY - 3 and dy <= thisY + 1)",
                "            then \"Yes\" else \"No\"",
                "          else \"No\",",
                "      type text),",
                "",
                "  Actuals =",
                "    Table.SelectRows(WithLast3,",
                "      each [Last_3_years] = \"Yes\"",
                "        and Record.HasFields(_, \"Value Type for Reporting Text\")",
                "        and [Value Type for Reporting Text] = \"Actual\"),",
                "",
                "  GM2 = Table.RenameColumns(Actuals, {{\"Net Sales Plan\", \"Net Sales Plan (EUR)\"}}, MissingField.Ignore),",
                "",
                "  // =========================",
                "  // Appends",
                "  // =========================",
                "  App1 = Table.Combine({ GM2, TD_Sales }),",
                "  App2 = Table.Combine({ App1, Shp_DatabaseBudgetReps }),",
                "",
                "  // Collapse any dup keys from appends (keep first)",
                "  App2_Collapsed = CollapseAllByKey(App2),",
                "",
                "  // Canonicalize RIGHT AFTER appends to a fixed contract",
                "  ContractEarly = {",
                "    \"Deemed Cost\",\"OIH Amt\",\"OIH Qty\",",
                "    \"Net Sales Plan (EUR)\",\"Net Sales Actual\",",
                "    \"Net Sales Qty Plan\",\"Net Sales Qty Actual\",",
                "    \"Customer\",\"Customer Name\",\"Fiscal year\",",
                "    \"Profit Center\",\"Record Type\",",
                "    \"Value Type for Reporting Text\",\"Currency\",",
                "    \"Date\",\"SalesAssignmentID\",",
                "    \"Final Destination\",\"Final Destination Text\",",
                "    \"Business Area Text\",\"Country Final Destination Text\",",
                "    \"Material\",\"Product Hierarchy Text\"",
                "  },",
                "  CanonEarly = CanonicalizeToContract(App2_Collapsed, ContractEarly),",
                "",
                "  // =========================",
                "  // Rest of logic on the canonical table",
                "  // =========================",
                "  NoErr =",
                "    if List.Contains(Table.ColumnNames(CanonEarly), \"SalesAssignmentID\")",
                "    then Table.RemoveRowsWithErrors(CanonEarly, {\"SalesAssignmentID\"})",
                "    else CanonEarly,",
                "",
                "  // Safe numeric casts",
                "  Typed0 =",
                "    let",
                "      cols = Table.ColumnNames(NoErr),",
                "      nums = List.Intersect({cols, {\"Deemed Cost\",\"Net Sales\",\"Net Sales Qty\",\"OIH Amt\",\"OIH Qty\",\"Net Sales Actual\",\"Net Sales Qty Actual\",\"Net Sales Qty Plan\"}})",
                "    in",
                "      if List.Count(nums)=0 then NoErr",
                "      else Table.TransformColumnTypes(NoErr, List.Transform(nums, each {_, type number})),",
                "",
                "  WithIndexCountry =",
                "    Table.AddColumn(Typed0, \"Index_Branch_CountryFinalDestination\",",
                "      each T(Record.FieldOrDefault(_, \"Business Area Text\")) & T(Record.FieldOrDefault(_, \"Country Final Destination Text\")), type text),",
                "",
                "  NoOTHBL =",
                "    Table.SelectRows(WithIndexCountry,",
                "      each let ba = try Text.From([Business Area Text]) otherwise null in ba = null or ba <> \"OTHBL\"),",
                "",
                "  WithFxIndex =",
                "    Table.AddColumn(NoOTHBL, \"Index_FxRates\",",
                "      each T(Record.FieldOrDefault(_, \"Business Area Text\"))",
                "         & T(Record.FieldOrDefault(_, \"Country Final Destination Text\"))",
                "         & T(Record.FieldOrDefault(_, \"Currency\")), type text),",
                "",
                "  WithFinalMaterial =",
                "    Table.AddColumn(WithFxIndex, \"Final_Material\",",
                "      each let m = try [Material] otherwise null",
                "           in  if m = null or (try Text.Length(Text.From(m)) otherwise 0) = 0",
                "               then T(Record.FieldOrDefault(_, \"Profit Center\"))",
                "               else Text.From(m), type text),",
                "",
                "  WithPrdHierFinal =",
                "    Table.AddColumn(WithFinalMaterial, \"Product Hierarchy Final\",",
                "      each let m = try [Material] otherwise null",
                "           in  if m = null",
                "               then T(Record.FieldOrDefault(_, \"Profit Center\"))",
                "               else T(Record.FieldOrDefault(_, \"Product Hierarchy Text\")), type text),",
                "",
                "  ProjectedMid =",
                "    Table.SelectColumns(",
                "      WithPrdHierFinal,",
                "      {",
                "        \"Deemed Cost\",\"OIH Amt\",\"OIH Qty\",",
                "        \"Net Sales Plan (EUR)\",\"Net Sales Actual\",",
                "        \"Net Sales Qty Plan\",\"Net Sales Qty Actual\",",
                "        \"Customer\",\"Customer Name\",\"Fiscal year\",",
                "        \"Profit Center\",\"Record Type\",",
                "        \"Value Type for Reporting Text\",\"Currency\",",
                "        \"Date\",\"SalesAssignmentID\",",
                "        \"Final Destination\",\"Final Destination Text\",",
                "        \"Index_Branch_CountryFinalDestination\",",
                "        \"Index_FxRates\",\"Final_Material\",\"Product Hierarchy Final\"",
                "      },",
                "      MissingField.UseNull",
                "    ),",
                "",
                "  // =========================",
                "  // FX merge → rename → type",
                "  // =========================",
                "  JoinFx =",
                "    Table.NestedJoin(ProjectedMid, {\"Index_FxRates\"}, Shp_Dim_FxRates, {\"Index_FxRates\"}, \"FX\", JoinKind.LeftOuter),",
                "  ExpFx =",
                "    Table.ExpandTableColumn(JoinFx, \"FX\", {\"Fx to EUR\",\"Fx to LC\"}, {\"FX.Fx to EUR\",\"FX.Fx to LC\"}),",
                "  RenFx =",
                "    Table.RenameColumns(ExpFx, {{\"FX.Fx to EUR\",\"FxtoEUR\"},{\"FX.Fx to LC\",\"FxtoLC\"}}, MissingField.Ignore),",
                "  TypedFx =",
                "    Table.TransformColumnTypes(RenFx, {{\"FxtoEUR\", type number},{\"FxtoLC\", type number}}, \"en-US\"),",
                "",
                "  // Collapse any dup keys that might have crept in late",
                "  LateCollapsed = CollapseAllByKey(TypedFx),",
                "",
                "  // FINAL canonicalization (adds FX columns to the contract)",
                "  ContractFinal = {",
                "    \"Deemed Cost\",\"OIH Amt\",\"OIH Qty\",",
                "    \"Net Sales Plan (EUR)\",\"Net Sales Actual\",",
                "    \"Net Sales Qty Plan\",\"Net Sales Qty Actual\",",
                "    \"Customer\",\"Customer Name\",\"Fiscal year\",",
                "    \"Profit Center\",\"Record Type\",",
                "    \"Value Type for Reporting Text\",\"Currency\",",
                "    \"Date\",\"SalesAssignmentID\",",
                "    \"Final Destination\",\"Final Destination Text\",",
                "    \"Index_Branch_CountryFinalDestination\",",
                "    \"Index_FxRates\",\"Final_Material\",\"Product Hierarchy Final\",",
                "    \"FxtoEUR\",\"FxtoLC\"",
                "  },",
                "  CanonFinal = CanonicalizeToContract(LateCollapsed, ContractFinal),",
                "",
                "  // Defaults on canonical table",
                "  DefFY =",
                "    if List.Contains(Table.ColumnNames(CanonFinal), \"Fiscal year\")",
                "    then Table.ReplaceValue(CanonFinal, null, \"2024\", Replacer.ReplaceValue, {\"Fiscal year\"})",
                "    else CanonFinal,",
                "",
                "  DefSalesAssign =",
                "    if List.Contains(Table.ColumnNames(DefFY), \"SalesAssignmentID\")",
                "    then Table.ReplaceValue(DefFY, null, \"||\", Replacer.ReplaceValue, {\"SalesAssignmentID\"})",
                "    else DefFY,",
                "    #\"Filtered Rows\" = Table.SelectRows(DefSalesAssign, each ([Index_Branch_CountryFinalDestination] = \"TIEIreland\" or [Index_Branch_CountryFinalDestination] = \"TUKEthiopia\" or [Index_Branch_CountryFinalDestination] = \"TUKGuernsey\" or [Index_Branch_CountryFinalDestination] = \"TUKJersey\" or [Index_Branch_CountryFinalDestination] = \"TUKSwitzerland\" or [Index_Branch_CountryFinalDestination] = \"TUKUnited Kingdom\" or [Index_Branch_CountryFinalDestination] = \"TUKUSA\") and ([Fiscal year] = \"2025\")),",
                "    #\"Grouped Rows\" = Table.Group(#\"Filtered Rows\", {\"Final Destination\", \"Final Destination Text\", \"Customer\", \"Customer Name\", \"Fiscal year\", \"Profit Center\", \"Index_Branch_CountryFinalDestination\", \"Product Hierarchy Final\", \"Final_Material\", \"SalesAssignmentID\"}, {{\"Net Sales Actual\", each List.Sum([Net Sales Actual]), type nullable number}, {\"Net Sales Qty Actual\", each List.Sum([Net Sales Qty Actual]), type nullable number}, {\"Net Sales Qty Plan\", each List.Sum([Net Sales Qty Plan]), type nullable number}, {\"Net Sales Plan (EUR)\", each List.Sum([#\"Net Sales Plan (EUR)\"]), type nullable number}}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Grouped Rows\", {\"Final_Material\"}, Dim_Product, {\"Material\"}, \"Dim_Product\", JoinKind.LeftOuter),",
