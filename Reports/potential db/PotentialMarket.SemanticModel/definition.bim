              "  AND(min('Button €/LC'[ID])=1,min('Button FiscalYTD'[ID])=2),CALCULATE(SUM('DATA'[Deemed Cost Actual (EUR)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscLY]),Dim_Cal[IsFiscLY]=1)),",
              "  AND(min('Button €/LC'[ID])=2,min('Button FiscalYTD'[ID])=2),CALCULATE(SUM('DATA'[Deemed Cost Actual (LC)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscLY]),Dim_Cal[IsFiscLY]=1)),",
              "  AND(min('Button €/LC'[ID])=1,min('Button FiscalYTD'[ID])=1),CALCULATE(SUM('DATA'[Deemed Cost Actual (EUR)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscYTD]),Dim_Cal[IsFiscYTD]=TRUE),FILTER( VALUES('Dim_Cal'[IsFiscLY]),Dim_Cal[IsFiscLY]=1)),",
              "  AND(min('Button €/LC'[ID])=2,min('Button FiscalYTD'[ID])=1), CALCULATE(SUM('DATA'[Deemed Cost Actual (LC)])/Scalling[SelectedScaling] ,FILTER(VALUES('Dim_Cal'[IsFiscYTD]),Dim_Cal[IsFiscYTD]=TRUE),FILTER( VALUES('Dim_Cal'[IsFiscLY]),Dim_Cal[IsFiscLY]=1)))",
              ""
            ],
            "formatString": "#,0",
