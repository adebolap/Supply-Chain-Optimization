        "lineageTag": "ef4905f1-ece5-49b1-bc30-67bb1d45fa7e",
        "measures": [
          {
            "name": "Total Leads",
            "displayFolder": "1. Base Counts",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        'Lead',",
              "        'Lead'[IsDeleted] = FALSE",
              "            && ISBLANK('Lead'[MasterRecordId])",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "fe6510b0-1a1a-4c56-9877-540ff127efd4"
          },
          {
            "name": "Leads Converted",
            "displayFolder": "1. Base Counts",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        'Lead',",
              "        'Lead'[IsConverted] = TRUE",
              "            && 'Lead'[IsDeleted] = FALSE",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "ca07437a-d50e-4e8a-ab94-af4513150638"
          },
          {
            "name": "Leads Not Converted",
            "displayFolder": "1. Base Counts",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        'Lead',",
              "        'Lead'[IsConverted] = FALSE",
              "            && 'Lead'[IsDeleted] = FALSE",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "7f6fb977-a514-4f7c-8a2d-cd22bf4b40c2"
          },
          {
            "name": "Leads Assigned to Reps",
            "displayFolder": "2. KPI 1 - Assignment",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        'Lead',",
              "        'Lead'[Status] IN {\"Working\", \"Nurturing\"}",
              "            && 'Lead'[IsDeleted] = FALSE",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "4a72014b-47da-48dc-a150-cf7403e5da2c"
          },
          {
            "name": "Leads in Queue (New)",
            "displayFolder": "2. KPI 1 - Assignment",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        'Lead',",
              "        'Lead'[Status] = \"New\"",
              "            && 'Lead'[IsDeleted] = FALSE",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "fed598f9-b683-4bca-8f5b-1255fa93b437"
          },
          {
            "name": "Leads Unqualified",
            "displayFolder": "2. KPI 1 - Assignment",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        'Lead',",
              "        'Lead'[Status] = \"Unqualified\"",
              "            && 'Lead'[IsDeleted] = FALSE",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "f8bb9cc9-1cd8-4413-bd2c-e5a8bceb9676"
          },
          {
            "name": "% Leads Assigned to Reps",
            "displayFolder": "2. KPI 1 - Assignment",
            "expression": [
              "",
              "DIVIDE(",
              "    [Leads Assigned to Reps],",
              "    [Total Leads],",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "6657e0e2-86a9-441a-aafa-c5bbc63de042"
          },
          {
            "name": "% Leads in Queue",
            "displayFolder": "2. KPI 1 - Assignment",
            "expression": [
              "",
              "DIVIDE(",
              "    [Leads in Queue (New)],",
              "    [Total Leads],",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "a878b24a-41ca-4af5-91c2-90cfda5e1f4d"
          },
          {
            "name": "% Leads Unqualified",
            "displayFolder": "2. KPI 1 - Assignment",
            "expression": "DIVIDE([Leads Unqualified],[Total Leads],0)",
            "formatString": "0.0%",
            "lineageTag": "53b0d131-457c-42da-a1bd-917d463a0fee"
          },
          {
            "name": "Avg Days in Queue",
            "displayFolder": "3. KPI 2 - Cycle Length",
            "expression": "AVERAGEX(FILTER('Lead','Lead'[Status] IN {\"Working\",\"Nurturing\",\"Converted\"} && NOT(ISBLANK('Lead'[LastModifiedDate])) && 'Lead'[IsDeleted] = FALSE),DATEDIFF('Lead'[CreatedDate],'Lead'[LastModifiedDate],DAY))",
            "formatString": "0.0",
            "lineageTag": "a0184ef0-2429-4488-8639-b9ebf3ee97d4"
          },
          {
            "name": "Median Days in Queue",
            "displayFolder": "3. KPI 2 - Cycle Length",
            "expression": "MEDIANX(FILTER('Lead','Lead'[Status] IN {\"Working\",\"Nurturing\",\"Converted\"} && NOT(ISBLANK('Lead'[LastModifiedDate])) && 'Lead'[IsDeleted] = FALSE),DATEDIFF('Lead'[CreatedDate],'Lead'[LastModifiedDate],DAY))",
            "formatString": "0.0",
            "lineageTag": "7e6418b0-e479-4025-991b-2ca44f089054"
          },
          {
            "name": "Conversion Rate (All Leads)",
            "displayFolder": "4. KPI 3 - Conversion",
            "expression": "DIVIDE([Leads Converted],[Total Leads],0)",
            "formatString": "0.0%",
            "lineageTag": "5eab2457-556e-4fcf-968d-c5de09a9427b"
          },
          {
            "name": "Conversion Rate (Assigned Leads)",
            "displayFolder": "4. KPI 3 - Conversion",
            "expression": "DIVIDE([Leads Converted],[Leads Assigned to Reps]+[Leads Converted],0)",
            "formatString": "0.0%",
            "lineageTag": "a419c315-ec4f-4767-8208-ab899ded5d0b"
          },
          {
            "name": "Leads with Activity (Last Activity Date)",
            "displayFolder": "5. KPI 4 - Follow-up",
            "expression": "COUNTROWS(FILTER('Lead',NOT(ISBLANK('Lead'[LastActivityDate])) && 'Lead'[IsDeleted] = FALSE))",
            "lineageTag": "8703d12e-1db5-42a5-b9d7-7b654b5f3a29"
          },
          {
            "name": "% Leads with Activity",
            "displayFolder": "5. KPI 4 - Follow-up",
            "expression": "DIVIDE([Leads with Activity (Last Activity Date)],[Total Leads],0)",
            "formatString": "0.0%",
            "lineageTag": "af6d9a00-8590-41a6-a2da-3570fe33ecc6"
          },
          {
            "name": "Leads with Opportunity",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "COUNTROWS(FILTER('Lead',NOT(ISBLANK('Lead'[ConvertedOpportunityId])) && 'Lead'[IsDeleted] = FALSE))",
            "lineageTag": "c84f848e-b7bd-4d53-92ba-314bf28dd413"
          },
          {
            "name": "% Converted Leads with Opportunity",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "DIVIDE([Leads with Opportunity],[Leads Converted],0)",
            "formatString": "0.0%",
            "lineageTag": "f8d04b9d-509a-47ba-857c-ab7e550565b6"
          },
          {
            "name": "Avg Lead Cycle Days (Total)",
            "displayFolder": "6. KPI 5 - Full Cycle",
            "expression": "AVERAGEX(FILTER('Lead','Lead'[IsConverted]=TRUE && NOT(ISBLANK('Lead'[ConvertedDate])) && 'Lead'[IsDeleted]=FALSE),DATEDIFF('Lead'[CreatedDate],'Lead'[ConvertedDate],DAY))",
            "formatString": "0.0",
            "lineageTag": "a80a866f-09ae-4af4-9135-69bbc7f7fb5a"
          },
          {
            "name": "Median Lead Cycle Days",
            "displayFolder": "6. KPI 5 - Full Cycle",
            "expression": "MEDIANX(FILTER('Lead','Lead'[IsConverted]=TRUE && NOT(ISBLANK('Lead'[ConvertedDate])) && 'Lead'[IsDeleted]=FALSE),DATEDIFF('Lead'[CreatedDate],'Lead'[ConvertedDate],DAY))",
            "formatString": "0.0",
            "lineageTag": "6a4273e2-ec38-4495-922e-51f847e0029b"
          },
          {
            "name": "Min Lead Cycle Days",
            "displayFolder": "6. KPI 5 - Full Cycle",
            "expression": "MINX(FILTER('Lead','Lead'[IsConverted]=TRUE && NOT(ISBLANK('Lead'[ConvertedDate])) && 'Lead'[IsDeleted]=FALSE),DATEDIFF('Lead'[CreatedDate],'Lead'[ConvertedDate],DAY))",
            "lineageTag": "05ef1656-2699-4e6a-a0ec-0037a74f803a"
          },
          {
            "name": "Max Lead Cycle Days",
            "displayFolder": "6. KPI 5 - Full Cycle",
            "expression": "MAXX(FILTER('Lead','Lead'[IsConverted]=TRUE && NOT(ISBLANK('Lead'[ConvertedDate])) && 'Lead'[IsDeleted]=FALSE),DATEDIFF('Lead'[CreatedDate],'Lead'[ConvertedDate],DAY))",
            "lineageTag": "fdad9cd0-ecdc-45aa-94f9-82a4554e16c5"
          },
          {
            "name": "Leads by Country",
            "displayFolder": "8. Breakdowns",
            "expression": "CALCULATE([Total Leads],ALLEXCEPT('Lead','Lead'[Country]))",
            "lineageTag": "144d61e2-6e10-4021-8fd5-b1538cf5b375"
          },
          {
            "name": "Leads by Cluster",
            "displayFolder": "8. Breakdowns",
            "expression": "CALCULATE([Total Leads],ALLEXCEPT('Mapping','Mapping'[TER_Region_Code__c]))",
            "lineageTag": "a96efcdf-dd93-461d-8dc4-184a14b5ea58"
          },
          {
            "name": "Leads by Owner",
            "displayFolder": "8. Breakdowns",
            "expression": "CALCULATE([Total Leads],ALLEXCEPT('User','User'[Name]))",
            "lineageTag": "f696522d-4230-45ff-a171-646daf16df25"
          },
          {
            "name": "Leads by Campaign Source",
            "displayFolder": "8. Breakdowns",
            "expression": "CALCULATE([Total Leads],ALLEXCEPT('Lead','Lead'[TER_Source_Campaign__c]))",
            "lineageTag": "49b9ff10-5b79-4aa1-bdbc-7e34fff7eee5"
          },
          {
            "name": "Leads Created This Month",
            "displayFolder": "9. Time Intelligence",
            "expression": "CALCULATE([Total Leads],MONTH('Lead'[CreatedDate])=MONTH(TODAY()),YEAR('Lead'[CreatedDate])=YEAR(TODAY()))",
            "lineageTag": "6640cfcb-8f3d-4299-86ca-d12a41e64ec1"
          },
          {
            "name": "Leads Converted This Month",
            "displayFolder": "9. Time Intelligence",
            "expression": "CALCULATE([Leads Converted],MONTH('Lead'[ConvertedDate])=MONTH(TODAY()),YEAR('Lead'[ConvertedDate])=YEAR(TODAY()))",
            "lineageTag": "a19df1d7-f130-42b7-a0a9-e404d905173f"
          },
          {
            "name": "TEST - Lead Owner Names",
            "displayFolder": "🧪 Test Measures",
            "expression": [
              "",
              "CONCATENATEX(",
              "    VALUES('Lead'[OwnerId]),",
              "    RELATED('User'[Name]),",
              "    \", \"",
              ")"
            ],
            "lineageTag": "ff0c8aa4-32e9-4ef8-a0b2-10637a1b5cb5"
          },
          {
            "name": "TEST - Country Cluster Mapping",
            "displayFolder": "🧪 Test Measures",
            "expression": [
              "",
              "CONCATENATEX(",
              "    VALUES('Lead'[Country]),",
              "    LOOKUPVALUE(",
              "        'Mapping'[TER_Region_Code__c],",
              "        'Mapping'[TER_Country__c],",
              "        'Lead'[Country]",
              "    ),",
              "    \", \"",
              ")"
            ],
            "lineageTag": "e6753fc0-6e52-4959-9127-c856f4cdc473"
          },
          {
            "name": "TEST - Converted with Opps",
            "displayFolder": "🧪 Test Measures",
            "expression": "COUNTROWS(FILTER('Lead','Lead'[IsConverted]=TRUE && NOT(ISBLANK(RELATED('Opportunity'[Id])))))",
            "lineageTag": "1351b32f-0297-478b-872c-efaf2586b9b9"
          },
          {
            "name": "KPI 1 Title",
            "displayFolder": "6. KPI Titles",
