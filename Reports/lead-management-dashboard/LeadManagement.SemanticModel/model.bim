        "lineageTag": "24afd00f-dea8-4ca0-97bd-d829942548a9",
        "measures": [
          {
            "name": "Total Opportunity Value (Won)",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "CALCULATE(SUM('Opportunity'[Amount]),'Opportunity'[IsWon]=TRUE,'Opportunity'[IsDeleted]=FALSE)",
            "formatString": "€#,0",
            "lineageTag": "ac0ad53d-b7e1-4afe-8be7-4eb20a2198b5"
          },
          {
            "name": "Total Opportunity Value (All)",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "CALCULATE(SUM('Opportunity'[Amount]),'Opportunity'[IsDeleted]=FALSE)",
            "formatString": "€#,0",
            "lineageTag": "b41792cc-080d-4953-b418-b79bf3cbea71"
          },
          {
            "name": "Opportunity Count (Won)",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "COUNTROWS(FILTER('Opportunity','Opportunity'[IsWon]=TRUE && 'Opportunity'[IsDeleted]=FALSE))",
            "lineageTag": "e9365157-e344-40e2-8d9b-63509d1c772d"
          },
          {
            "name": "Opportunity Count (All)",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "COUNTROWS(FILTER('Opportunity','Opportunity'[IsDeleted]=FALSE))",
            "lineageTag": "fb528a73-b502-4461-85c2-afb93af3dd8a"
          },
          {
            "name": "Avg Opportunity Value",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "DIVIDE([Total Opportunity Value (Won)],[Opportunity Count (Won)],0)",
            "formatString": "€#,0",
            "lineageTag": "fd2b48c1-9077-4600-8d9c-3c302cf05ff9"
          },
          {
            "name": "Avg Opportunity Value per Converted Lead",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "DIVIDE([Total Opportunity Value (Won)],[Leads with Opportunity],0)",
            "formatString": "€#,0",
            "lineageTag": "6e23b226-7fa7-4d2e-91f3-bfe532a310b5"
          },
          {
            "name": "Win Rate (Opportunities)",
            "displayFolder": "7. KPI 6 - ROI",
            "expression": "DIVIDE([Opportunity Count (Won)],[Opportunity Count (All)],0)",
            "formatString": "0.0%",
            "lineageTag": "6a5017d1-7bf3-48d6-ae0f-59021338d9ad"
          },
          {
            "name": "Revenue by Business Line",
            "displayFolder": "8. Breakdowns",
            "expression": "CALCULATE([Total Opportunity Value (Won)],ALLEXCEPT('Opportunity','Opportunity'[TER_Business_Line__c]))",
            "formatString": "€#,0",
