            "sourceColumn": "[SortOrder]",
            "lineageTag": "79d19bfa-946d-4402-a576-c3b339dfba97"
          }
        ],
        "partitions": [
          {
            "name": "DNA_Category",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE (",
                "    \"Category\", STRING,",
                "    \"SortOrder\", INTEGER,",
                "    {",
                "        { \"DNA\",    1 },",
                "        { \"DA\",     2 },",
                "        { \"DN\",     3 },",
                "        { \"NA\",     4 },",
                "        { \"D only\", 5 },",
                "        { \"N only\", 6 },",
                "        { \"A only\", 7 },",
                "        { \"Others\", 8 }",
                "    }",
                ")"
              ]
            }
          }
        ]
      },
      {
