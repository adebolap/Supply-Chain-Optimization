        "measures": [
          {
            "name": "Leads with Task Activity",
            "displayFolder": "5. KPI 4 - Follow-up",
            "expression": "DISTINCTCOUNT('Task'[WhoId])",
            "lineageTag": "2a47d702-0fdd-4ca1-b03f-b3c9bbe772bb"
          },
          {
            "name": "Total Task Count",
            "displayFolder": "5. KPI 4 - Follow-up",
            "expression": "COUNTROWS('Task')",
            "lineageTag": "9f257e83-0718-4b59-8f4e-a73c3f2b9b14"
          },
          {
            "name": "Avg Tasks per Lead",
            "displayFolder": "5. KPI 4 - Follow-up",
            "expression": "DIVIDE([Total Task Count],[Leads with Task Activity],0)",
            "formatString": "0.0",
            "lineageTag": "fd7659be-7fa8-4efe-b212-7707ae54024e"
          },
          {
            "name": "Tasks Completed",
            "displayFolder": "5. KPI 4 - Follow-up",
            "expression": "COUNTROWS(FILTER('Task','Task'[IsClosed]=TRUE))",
            "lineageTag": "c45afee1-e2d7-4e38-8492-7d9f88671d7e"
          },
          {
            "name": "Task Completion Rate",
            "displayFolder": "5. KPI 4 - Follow-up",
            "expression": "DIVIDE([Tasks Completed],[Total Task Count],0)",
            "formatString": "0.0%",
            "lineageTag": "1c2eecb1-b9f4-41f5-acca-5a43ca1e649d"
          },
          {
            "name": "Tasks by Task Owner",
            "displayFolder": "5. KPI 4 - Follow-up",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Task Count],",
              "    USERELATIONSHIP('Task'[OwnerId], 'User'[Id])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "2e08a5f1-45e4-44e6-8113-ac5a9e156e0c"
          }
        ],
