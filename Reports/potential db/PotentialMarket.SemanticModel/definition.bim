      {
        "name": "Shp_DatabaseBudgetReps",
        "kind": "m",
        "expression": [
          "let",
          "  // ============= Helpers (same fixes) =============",
          "  NormalizeName = (n as text) as text =>",
          "      let",
          "          s0   = if n = null then \"\" else n,",
          "          nb   = Character.FromNumber(160),   zws  = Character.FromNumber(8203),",
          "          thin = Character.FromNumber(8201),  ensp = Character.FromNumber(8194),",
          "          emsp = Character.FromNumber(8195),  nnbsp= Character.FromNumber(8239),",
          "          bom  = Character.FromNumber(65279), ide  = Character.FromNumber(12288),",
          "          s1   = Text.Replace(s0, nb,  \" \"),",
          "          s2   = Text.Replace(s1, zws, \" \"),",
          "          s3   = Text.Replace(s2, thin,\" \"),",
          "          s4   = Text.Replace(s3, ensp,\" \"),",
          "          s5   = Text.Replace(s4, emsp,\" \"),",
          "          s6   = Text.Replace(s5, nnbsp,\" \"),",
          "          s7   = Text.Replace(s6, bom, \" \"),",
          "          s8   = Text.Replace(s7, ide, \" \"),",
          "          s9   = Text.Replace(Text.Replace(Text.Replace(s8, \"#(tab)\", \" \"), \"#(cr)\", \" \"), \"#(lf)\", \" \"),",
          "          s10  = Text.Replace(Text.Replace(s9, \"_\", \" \"), \"-\", \" \"),",
          "          t1   = Text.Trim(s10),",
          "          parts= List.Select(Text.Split(t1, \" \"), each _ <> \"\"),",
          "          t2   = Text.Combine(parts, \" \")",
          "      in  t2,",
          "  CanonKey = (n as text) as text => Text.Lower(NormalizeName(n)),",
          "  MakeUniqueHeaders_CI = (t as table) as table =>",
          "      let",
          "        cols = Table.ColumnNames(t),",
          "        keys = List.Transform(cols, each CanonKey(_)),",
          "        new  = List.Transform({0..List.Count(cols)-1}, (i) =>",
          "                let",
          "                  k         = keys{i},",
          "                  priorList = List.FirstN(keys, i),",
          "                  prior     = List.Count(List.Select(priorList, each _ = k))",
          "                in  if prior = 0 then cols{i} else cols{i} & \" (dup \" & Text.From(prior) & \")\"),",
          "        renamed = Table.RenameColumns(t, List.Zip({cols, new}), MissingField.Ignore)",
          "      in  renamed,",
          "  SetTypesIfPresent = (tbl as table, pairs as list) as table =>",
          "      let cols = Table.ColumnNames(tbl),",
          "          safe = List.Select(pairs, each List.Contains(cols, _{0}))",
          "      in  if List.Count(safe)=0 then tbl else Table.TransformColumnTypes(tbl, safe),",
          "",
          "  // ============= Source (Power Platform Dataflows) =============",
          "  Source     = PowerPlatform.Dataflows(null),",
          "  Workspaces = Source{[Id=\"Workspaces\"]}[Data],",
          "  WS         = Workspaces{[workspaceId=\"c7278fbc-be79-4417-beee-03375630b51d\"]}[Data],",
          "  DF         = WS{[dataflowId=\"3ae381a4-663d-4123-a364-92004a591bc0\"]}[Data],",
          "  TotalBudget= DF{[entity=\"Total Budget\", version=\"\"]}[Data],",
          "",
          "  UniqueHeaders = MakeUniqueHeaders_CI(TotalBudget),",
          "",
          "  Renamed = Table.RenameColumns(",
          "              UniqueHeaders,",
          "              {{\"Product hierarchy Text\",\"Product Hierarchy Text\"}, {\"Fiscal Year\",\"Fiscal year\"}},",
          "              MissingField.Ignore",
          "            ),",
          "",
          "  Typed =",
          "    SetTypesIfPresent(",
          "      Renamed,",
          "      {",
          "        {\"OIH Amt\", type number},",
          "        {\"OIH Qty\", type number},",
          "        {\"Net Sales Plan (EUR)\", type number},",
          "        {\"Net Sales Qty Plan\", type number},",
          "        {\"Customer\", type text},",
          "        {\"Customer Name\", type text},",
          "        {\"Fiscal year\", Int64.Type},",
          "        {\"Profit Center\", type text},",
          "        {\"Record Type\", type text},",
          "        {\"Value Type for Reporting Text\", type text},",
          "        {\"Currency\", type text},",
          "        {\"Date\", type date},",
          "        {\"SalesAssignmentID\", type text},",
          "        {\"Final Destination\", type text},",
          "        {\"Final Destination Text\", type text},",
          "        {\"Business Area Text\", type text},",
          "        {\"Country Final Destination Text\", type text},",
          "        {\"Material\", type text},",
          "        {\"Product Hierarchy Text\", type text}",
          "      }",
          "    )",
          "in",
          "  Typed"
        ],
        "queryGroup": "1. Main Database",
        "lineageTag": "de2627bf-97b5-46e0-aaef-a800b40bcb5d",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
