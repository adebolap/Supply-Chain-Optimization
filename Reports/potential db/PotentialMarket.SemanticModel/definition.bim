          {
            "type": "calculated",
            "name": "CalendarQuarterNumber",
            "dataType": "int64",
            "description": "Calendar quarter (1-4). Q1=Jan-Mar, Q2=Apr-Jun, Q3=Jul-Sep, Q4=Oct-Dec.",
            "expression": "INT ( ( Dim_Cal[Month] - 1 ) / 3 ) + 1",
            "displayFolder": "Quarter",
            "lineageTag": "1dc88cf5-2019-4cd2-82c2-5a398c1e29e4"
          },
          {
            "type": "calculated",
            "name": "FiscYearQuarter",
            "dataType": "string",
            "description": "Fiscal year-quarter label (e.g. FY2025-Q1). April = Q1.",
            "expression": "\"FY\" & Dim_Cal[Fiscal Year] & \"-Q\" & Dim_Cal[Fiscal Quarter Number]",
            "sortByColumn": "FiscQuarterIndex",
            "displayFolder": "Quarter",
            "lineageTag": "c5d6fee0-304c-4cf8-ad03-845f20317eb5"
          },
          {
            "type": "calculated",
            "name": "CalYearQuarter",
            "dataType": "string",
            "description": "Calendar year-quarter label (e.g. CY2025-Q1). January = Q1.",
            "expression": "\"CY\" & Dim_Cal[Calendar Year] & \"-Q\" & ( INT ( ( Dim_Cal[Month] - 1 ) / 3 ) + 1 )",
            "sortByColumn": "CalQuarterIndex",
            "displayFolder": "Quarter",
            "lineageTag": "06b166b5-4191-460b-a081-88b07edbcfeb"
          },
          {
            "type": "calculated",
            "name": "FiscQuarterIndex",
            "dataType": "int64",
            "description": "Sequential fiscal quarter index. Prior quarter = index - 1.",
            "isHidden": true,
            "expression": "Dim_Cal[Fiscal Year] * 4 + Dim_Cal[Fiscal Quarter Number]",
            "displayFolder": "Quarter",
            "lineageTag": "6f3bf65e-912e-49d7-8fcb-a9d9c3971168"
          },
          {
            "type": "calculated",
            "name": "CalQuarterIndex",
            "dataType": "int64",
            "description": "Sequential calendar quarter index. Prior quarter = index - 1.",
            "isHidden": true,
            "expression": "Dim_Cal[Calendar Year] * 4 + ( INT ( ( Dim_Cal[Month] - 1 ) / 3 ) + 1 )",
            "displayFolder": "Quarter",
            "lineageTag": "6af1df6b-1b65-4647-9452-6ce424e12b8c"
          }
