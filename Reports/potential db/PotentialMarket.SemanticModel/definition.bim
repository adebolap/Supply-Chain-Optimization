          },
          {
            "name": "FY GP CY",
            "description": "Calculates the gross profit for current FY ( Total sales - Total deemed cost )",
            "expression": "IF(COUNTROWS('Security Cost') =1 || AND(NOT(ISFILTERED(Dim_Product[Material Code & Name])),AND(NOT(ISFILTERED(Dim_Product[Product Group 2])),NOT(ISFILTERED(Dim_Product[Product Group 3])))),[FY Sales CY]-[FY DC CY],BLANK())",
            "formatString": "#,0",
