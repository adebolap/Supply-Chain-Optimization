              "  AND(min('Button €/LC'[ID])=2,min('Button FiscalYTD'[ID])=2),CALCULATE(SUM('DATA'[Net Sales Plan (LC)])/Scalling[SelectedScaling],FILTER(VALUES('Dim_Cal'[IsFiscCY]),Dim_Cal[IsFiscCY]=TRUE)),",
