          {
            "name": "Button Figures-199132cb-4173-4404-bfab-387dd8928d22",
            "mode": "import",
            "queryGroup": "5. Dashboard Filters",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WCk7MSS1W0lEyVIrViVYKzcssAfGMwDzH4AAg2xjMdgcxTaBMVSDbVCk2FgA=\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Figures = _t, Index = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Figures\", type text}, {\"Index\", Int64.Type}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"Index\", \"Index Figures\"}}),",
                "    #\"Removed Bottom Rows\" = Table.RemoveLastN(#\"Renamed Columns\",1),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Removed Bottom Rows\",{{\"Index Figures\", \"Index\"}})",
                "in",
                "    #\"Renamed Columns1\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
