// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (NextAuth) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  weddings Wedding[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Core domain ---

enum Tier {
  FREE
  PREMIUM
}

model Wedding {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  weddingDate DateTime
  rsvpDeadline DateTime?
  tier      Tier     @default(FREE)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Co-planner's email, granted the same access as the owner once they sign in with it.
  partnerEmail String?

  /// Shared with trusted door staff only; unlocks manual name-based check-in.
  checkInPin String?

  /// Check-in (scan or admin) admits nobody before this time. Null = no restriction.
  checkInOpensAt DateTime?

  events            Event[]
  guests            Guest[]
  tables            Table[]
  checklistItems    ChecklistItem[]
  broadcastMessages BroadcastMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(cuid())
  weddingId String
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  name      String // e.g. "Ceremony", "Rehearsal Dinner", "Reception"
  startsAt  DateTime
  location  String?

  rsvps  RSVP[]
  tables Table[]

  createdAt DateTime @default(now())
}

enum GuestSide {
  PARTNER_ONE
  PARTNER_TWO
  SHARED
}

model Guest {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  email        String?
  phone        String?
  household    String? // groups guests arriving/seated together
  side         GuestSide @default(SHARED)
  tags         String[] // e.g. ["family", "bridal party", "plus-one"]
  dietaryNotes String?
  notes        String? // catch-all, e.g. mailing address imported from a spreadsheet

  checkInToken String @unique @default(cuid()) // encoded in the guest's QR code
  rsvpToken    String @unique @default(cuid()) // personal RSVP link; distinct from checkInToken so sharing one never leaks the other

  rsvps RSVP[]
  seat  Seat?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId])
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
}

model RSVP {
  id      String @id @default(cuid())
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status     RsvpStatus @default(PENDING)
  mealChoice String?
  plusOne    Boolean    @default(false)
  plusOneName String?
  notes      String?

  checkedInAt DateTime?

  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([guestId, eventId])
}

model Table {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name     String
  capacity Int    @default(8)
  posX     Float  @default(0)
  posY     Float  @default(0)

  seats Seat[]

  createdAt DateTime @default(now())

  @@index([weddingId])
  @@index([eventId])
}

model Seat {
  id      String @id @default(cuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guestId String @unique
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  position Int @default(0)
}

enum ChecklistCategory {
  GUEST_LIST
  RSVP
  SEATING
  GENERAL
}

model ChecklistItem {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  title      String
  dueDate    DateTime?
  category   ChecklistCategory @default(GENERAL)
  isComplete Boolean           @default(false)

  createdAt DateTime @default(now())

  @@index([weddingId])
}

// --- Broadcast messaging (email/SMS announcements to the guest list) ---

enum BroadcastChannel {
  EMAIL
  SMS
}

model BroadcastMessage {
  id        String  @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  channel        BroadcastChannel
  subject        String? // email only
  body           String
  audience       String // human-readable description, e.g. "All guests" or "Haven't RSVP'd yet"
  recipientCount Int    @default(0)
  failureCount   Int    @default(0)

  createdAt DateTime @default(now())

  @@index([weddingId])
}
